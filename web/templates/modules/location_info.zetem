{#
  Read-only badge -- shows the current location, unchangeable from here.
  The actual "change location" select lives on the profile page
  (web/templates/blocks/user_profile.zetem), which posts to the same
  /updatelocation route via the location-places library's JS/CSS.
#}
<div class="location-place">
    <i class="bx bx-map"></i>
    <span class="location-badge">{{t("Location")}}: <strong>{{{$location}}}</strong></span>
</div>
