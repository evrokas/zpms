{% attach_library('backup-library') %}

<div class="backup-container">
    <h1>{{t("Backups")}}</h1>
    <p class="backup-note">
        {{t("Backups run automatically overnight and are not triggered from this page. This shows the status of the last run.")}}
    </p>

    <section class="backup-status">
        {% if(is_null($status)): %}
            <p class="backup-status-unknown">
                {{t("No backup has run on this server yet, or backups have not been configured -- see deploy/backup.conf.example.")}}
            </p>
        {% else: %}
            {% if($status['status'] == 'success'): %}
                <p class="backup-status-ok">
                    {{t("Last backup run succeeded.")}}
                </p>
            {% else: %}
                <p class="backup-status-failed">
                    {{t("Last backup run FAILED -- check web/files/logs/backup.log on the server.")}}
                </p>
            {% endif %}
            <p class="backup-status-time">
                {{t("Last run:")}} {{{$status['last_run_ts']}}}
            </p>
        {% endif %}
    </section>
</div>
