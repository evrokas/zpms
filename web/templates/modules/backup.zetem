{% attach_library('backup-library') %}

<div class="backup-container">
    <h1>{{t("Backups")}}</h1>
    <p class="backup-note">
        {{t("Backups run automatically overnight and are not triggered from this page. This shows the status of the last run.")}}
    </p>

    <section class="backup-status">
        {% if(is_null($status)): %}
            <p class="backup-status-unknown">
                {{t("No backup has run on this server yet, or backups have not been configured -- see deploy/backup.conf.example.")}}
            </p>
        {% else: %}
            {% if($status['status'] == 'success'): %}
                <p class="backup-status-ok">
                    {{t("Last backup run succeeded.")}}
                </p>
            {% else: %}
                <p class="backup-status-failed">
                    {{t("Last backup run FAILED -- check web/files/logs/backup.log on the server.")}}
                </p>
            {% endif %}
            <p class="backup-status-time">
                {{t("Last run:")}} {{{$status['last_run_ts']}}}
            </p>
        {% endif %}
    </section>

    <section class="backup-generations">
        <h2>{{t("Available Backups")}}</h2>
        {% if(is_null($generations)): %}
            <p class="backup-status-unknown">
                {{t("No generation list is available yet -- it is written by bin/backup.sh on its next successful run.")}}
            </p>
        {% else: %}
            <p class="backup-generations-time">
                {{t("As of:")}} {{{$generations['generated_at']}}}
            </p>

            <div class="backup-tier">
                <h3>{{t("Daily")}}</h3>
                {% if(empty($generations['tiers']['daily'])): %}
                    <p class="backup-tier-empty">{{t("No generations yet.")}}</p>
                {% else: %}
                    <ul class="backup-tier-list">
                        {% foreach(array_reverse($generations['tiers']['daily']) as $generation): %}
                            <li>{{{$generation}}}</li>
                        {% endforeach %}
                    </ul>
                {% endif %}
            </div>

            <div class="backup-tier">
                <h3>{{t("Weekly")}}</h3>
                {% if(empty($generations['tiers']['weekly'])): %}
                    <p class="backup-tier-empty">{{t("No generations yet.")}}</p>
                {% else: %}
                    <ul class="backup-tier-list">
                        {% foreach(array_reverse($generations['tiers']['weekly']) as $generation): %}
                            <li>{{{$generation}}}</li>
                        {% endforeach %}
                    </ul>
                {% endif %}
            </div>

            <div class="backup-tier">
                <h3>{{t("Monthly")}}</h3>
                {% if(empty($generations['tiers']['monthly'])): %}
                    <p class="backup-tier-empty">{{t("No generations yet.")}}</p>
                {% else: %}
                    <ul class="backup-tier-list">
                        {% foreach(array_reverse($generations['tiers']['monthly']) as $generation): %}
                            <li>{{{$generation}}}</li>
                        {% endforeach %}
                    </ul>
                {% endif %}
            </div>
        {% endif %}
    </section>
</div>
