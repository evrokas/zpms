{% attach_library('qrgenerator-library') %}


{# Visually hidden: the breadcrumb above already names this page. Kept as the
   page heading for screen readers. #}
<h1 class="sr-only">{{{t('QR Generator Application')}}}</h1>

<div class="genqr">
    <form action="/apps/genqr" method="post">
        {{ csrf_field() }}
        <!-- <label for="qrtext">Text</label> -->
        <input type="text" name="qrtext" id="qrtext" placeholder="{{{t('Enter the text to be encoded')}}}">
        <div class="options">
            <span>{{{t('Options')}}}</span>
            <div class="inputraw">
                <label for="imagetype">{{{t('Type')}}}</label>
                <select name="imagetype" id="imagetype">
                    <option value="png" selected>PNG</option>
                    <option value="svg">SVG</option>
                </select>
            </div>

            <div class="inputraw">
                <label for="imagedpi">{{{t('DPI')}}}</label>
                <select name="imagedpi" id="imagedpi">
                    <option value="75">75</option>
                    <option value="100">100</option>
                    <option value="150" selected>150</option>
                    <option value="200">200</option>
                    <option value="300">300</option>
                    <option value="600">600</option>
                </select>
            </div>
            
            <div class="inputraw">
                <label for="margins">{{{t('Margin (px)')}}}</label>
                <select name="margins" id="margins">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3" selected>3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                </select>
            </div>

            <div class="inputraw">
                <label for="errorcorrection">{{{t('Error correction')}}}</label>
                <select name="errorcorrection" id="errorcorrection">
                    <option value="L">{{{t('Low (L)')}}}</option>
                    <option value="M">{{{t('Medium (M)')}}}</option>
                    <option value="Q" selected>{{{t('High (Q)')}}}</option>
                    <option value="H">{{{t('Highest (H)')}}}</option>
                </select>
            </div>

        </div>



        <button type="submit">{{{t('Generate')}}}</button>

    
    </form>

    <div class="output">
        {% if(isset($qrimage)): %}
            <div class="text">
                {{{t('Text')}}}: <span>{{{$qrtext}}}</span>
            </div>
            <div class="qrimage">
                <img src="{{$qrimage|cache_asset}}" id="qrimage" alt="{{{t('Generated QR image')}}}">
            </div>
        {% endif %}
    </div>

</div>