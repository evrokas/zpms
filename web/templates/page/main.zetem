<!DOCTYPE html>
<html lang="en">

<head>
    <meta name="csrf-token" content="{{ csrf_token() }}">

    <!-- IBM Plex Sans (UI/body/data) + IBM Plex Serif (headings) -- one
         type family at two roles, chosen specifically because both ship
         a Greek subset (this app is Greek-language throughout, and a
         silent Latin-only fallback would be worse than the plain system
         sans it replaces). -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Serif:wght@500;600;700&display=swap" rel="stylesheet">

    {% if(isset($meta))foreach($meta as $metaline): %}
        <meta {{ $metaline }}>
    {% endforeach; %}

    {# check to see if there is title defined in yaml #}
    {% if(isset($title)): %}
        <title>{{ $title }}</title>
    {% endif %}

    {% if(isset($links))foreach($links as $link): %}
        <link {{$link->getAttributes()}}>
    {% endforeach; %}

    {% foreach($head_links as $hlink): %}
        <script head_links {{$hlink->getAttributes()}}></script>
    {% endforeach %}

    {#
    {% if(isset($head_scripts))foreach($head_scripts as $scrpt): %}
        <script head_scripts type="{{$scrpt['type']}}" src="{{rel_url($scrpt['src'])}}"></script>
    {% endforeach; %}
    #}
</head>
<body>

    {% if(isset($fonts))foreach($fonts as $font): %}
    <style type="text/css">
        @font-face {
            font-family: "{{ $font['font-family'] }}";
            src: url( "{{ rel_url( $font['url']) }}" ) {% if(isset($font['format'])): %} format("{{$font['format'] }}") {% endif %};
        }
    </style>
    {% endforeach %}


    {% include page.zetem %}

    {% if(isset($foot_links))foreach($foot_links as $link): %}
        <script foot_links {{$link->getAttributes()}}></script>
    {% endforeach; %}

</body>
