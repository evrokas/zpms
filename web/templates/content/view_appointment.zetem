{% attach_library('textarea-autoexpand-library') %}
{% attach_library('appointment-improvements') %}

<div class="appointment-entry card mb-lg" id="app-{{$index}}">
    <div class="card-body">
        <form action="{{$action}}" method="post">
            <div class="form-grid">
                <div class="form-group">
                    <div class="input-div" role="rendezvouz">
                        <label for="patient-date">{{t("Appointment Date")}}</label>
                        <input type="date" loader="app-loader-{{$index}}" name="appointment-date-{{$index}}" id=""
                            role="date-picker" value="{{formatBrowserDate($appointment->getadate())}}">
                    </div>
                </div>

                <div class="form-group">
                    <div class="input-div">
                        <label for="appointment-place" role="location">{{t("Location")}}</label>
                        <select name="appointment-place" loader="app-loader-{{$index}}">
                            {% foreach($locations as $loc): %}
                            <option value="{{$loc->getmachinename()}}" {{($loc->getname() ==
                                $appointment->getaplace())?"selected":""}}>{{$loc->getname()}}</option>
                            {% endforeach %}
                        </select>
                    </div>
                </div>
            </div>

            <div id="app-loader-{{$index}}" class="loader0"></div>

            <div class="form-group">
                <div class="input-div input-notes">
                    <label for="appointment-notes">{{t("Notes")}}</label>
                    <textarea name="appointment-notes" id="" autoexpand rows="5"
                        loader="app-loader-{{$index}}">{{$appointment->getanote()}}</textarea>
                </div>
            </div>

            <div class="file-upload-section">
                <h5>{{t("Attached Files")}}</h5>
                <div class="file-upload-area">
                    <input type="file" id="file-upload-1" multiple accept="image/*,.pdf" class="file-input">
                    <label for="file-upload-1" class="file-upload-label">
                        <i class='bx bx-cloud-upload'></i>
                        <span>{{t("Select or drag files here")}}</span>
                    </label>
                </div>

                <div class="file-previews" id="file-previews-1"></div>

                <div class="existing-files">
                    <p>{{t("existing files")}}</p>
                    <div class="file-item">
                        <div class="file-preview">
                            <img src="path/to/thumbnail.jpg" alt="File preview">
                        </div>
                        <div class="file-info">
                            <span class="file-name">medical_report.pdf</span>
                            <span class="file-size">2.4 MB</span>
                        </div>
                        <div class="file-actions">
                            <button class="btn btn-sm btn-outline" data-file="path/to/file.pdf">{{t("View")}}</button>
                            <button class="btn btn-sm btn-danger">{{t("Delete")}}</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <input type="submit" name="submit" class="btn btn-primary" value="{{t('Save')}}">
                <input type="submit" name="delete" class="btn btn-danger" value="{{t('Delete')}}">
                <button hidden type="button" loader="app-loader-{{$index}}"
                    onclick="field_update(this)">Update</button>
            </div>
        </form>
    </div>
</div>
