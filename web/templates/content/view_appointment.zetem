{% attach_library('appointment-improvements') %}
{% attach_library('loader-library') %}
{% attach_library('flatpickr-library') %}

<!-- <hr> -->
<!-- appointment-type-operation/-visit drives this whole card's accent
     color (left border + type label/icon color -- see .appointment-entry
     in styles.css) so a surgery reads as visually distinct from a plain
     appointment at a glance, scanning down a list of several cards,
     without having to read the label text on each one. -->
<div class="appointment-entry appointment-type-{{($appointment->getatype() == 'operation')?'operation':'visit'}}" id="app-{{$index}}">
    <span class="appointment-index-badge" title="{{{t('Appointment/Operation #@number in sequence for this patient', ['number' => $index])}}}">#{{$index}}</span>
    <form action="{{$action}}" method="post">
        {{ csrf_field() }}
        <fieldset {% if(!$can_edit): %}disabled{% endif %}>
        <div class="input-header">
            <div class="input-div" role="rendezvouz">
                <!-- <label for="patient-date">Ημ/νια & Ώρα ραντεβού</label> -->
                <!-- <input type="datetime-local" loader="app-loader-{{$index}}" name="appointment-date" id="" value="{{$appointment->getadate()}}"> -->
                <!-- Doubles as this card's type indicator -- fixed at
                     creation, never editable here (see
                     patient_appointment_new_render()'s own comment in
                     web/index.php for where the type is actually decided:
                     which "Add ..." button was clicked on the patient
                     page). No dropdown/badge/appointment-type field
                     anywhere in this form. The icon (CSS ::before, see
                     .appointment-type-visit/-operation in styles.css)
                     is purely decorative/type-redundant, so nothing here
                     needs an alt-text equivalent for it. -->
                <label for="appointment-date-{{$index}}">{{($appointment->getatype() == 'operation') ? t('Operation') : t('Appointment')}}</label>
                <input type="text" loader="app-loader-{{$index}}" name="appointment-date-{{$index}}" id="appointment-date-{{$index}}"
                    role="date-picker" value="{{formatBrowserDate($appointment->getadate())}}">
                <!-- <label for="patient-dob">Ημ/νια Γεννήσεως</label> -->
                <!-- <input type="date" name="patient-dob" id="" role="date-picker" value="{{formatDate($patient->getpdob())}}"> -->
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    var dateInput = document.getElementById('appointment-date-{{$index}}');

                    flatpickr(dateInput, {
                        dateFormat: 'Y-m-d',
                        altInput: true,
                        altFormat: 'd-m-Y',
                        allowInput: true,
                        onChange: function(selectedDates, dateStr, instance) {
                            /* loader.js's own window-load handler binds its
                             * autosave listener directly to this input's
                             * native 'input' event (see input[loader="..."]
                             * in web/js/loader.js) -- flatpickr updates
                             * instance.input.value without dispatching that
                             * event itself, so a picked date would silently
                             * never trigger the same live-save every other
                             * field on this form already gets on keystroke. */
                            instance.input.dispatchEvent(new Event('input', { bubbles: true }));
                        }
                    });
                });
            </script>

            <div class="input-div">
                <label for="appointment-place" role="location"><i class='bx bx-map-pin'></i> {{{t('Area')}}}</label>
                <!-- <input type="text" name="appointment-place" id=""  value="{{$appointment->getaplace()}}"> -->

                <!-- {% if(isset($locations)): %} -->
                <select name="appointment-place" loader="app-loader-{{$index}}">
                    {% foreach($locations as $loc): %}
                    <!-- {{ $loc->getname() }} - {{ $loc->getmachinename() }} {{$appointment->getaplace()}} -->
                    <option value="{{$loc->getmachinename()}}" {{($loc->getname() ==
                        $appointment->getaplace())?"selected":""}}>{{$loc->getname()}}</option>
                    {% endforeach %}
                </select>
                <!-- {% endif %} -->
            </div>
        </div>
        <div id="app-loader-{{$index}}" class="loader0"></div>

        <div class="appointment-wrapper">
            <div class="edit-appointment">

                <div class="input-div input-notes">
                    <label for="appointment-notes">{{{t('Notes')}}}</label>
                    <!-- Sizing is pure CSS now (field-sizing: content +
                         min-block-size: 5lh on textarea, see styles.css)
                         -- grows to fit content on its own, with no JS
                         needed (web/js/textarea-autoexapand.js, which did
                         this by hand on every keyup, is gone). rows="2" is
                         just the pre-field-sizing-support fallback size. -->
                    <textarea name="appointment-notes" id="" rows="2"
                        loader="app-loader-{{$index}}">{{$appointment->getanote()}}</textarea>
                </div>

                {% if($can_edit): %}
                <div class="buttons">
                    <input type="submit" name="submit" value="{{{t('Save')}}}">
                    <input type="submit" name="delete" value="{{{t('Delete')}}}">
                    <!-- <input type="submit" name="cancel" value="cancel"> -->
                    <button hidden type="button" loader="app-loader-{{$index}}"
                        onclick="field_update(this)">{{{t('Update')}}}</button>
                </div>
                {% endif %}
            </div>
        </div>
        </fieldset>
    </form>

    <!-- Attachments for this appointment -- deliberately outside the form
         above (own enctype/async submission timing, must not risk being
         swept into the place/date/notes save). Collapsed by default and
         expanded by clicking the heading, except it starts already
         expanded when there are existing files, so staff land straight
         on them instead of an empty-looking closed section.

         This template is now rendered for two kinds of viewer:
         appointment-edit (full read/write) and appointment-view
         (read-only -- 'secretary' in web/rbac_seed.php), never for a
         viewer holding neither (see patient_edit() in web/index.php --
         that case gets a compact summary instead, built inline in
         edit_patient.zetem, never this full form). $can_edit (passed
         from patient_edit()) tells the two apart: the fieldset above
         already disables the date/place/notes fields and the save/
         delete buttons are omitted outright when it's false. Below,
         the same flag hides the upload dropzone, the clipboard-paste
         row, and each file's own Διαγραφή button -- appointment_files.php's
         own handlers independently call rbacClass::require(ZPMS_PERM_APPOINTMENT_EDIT)
         regardless, so this is purely cosmetic, not the actual
         authorization boundary. The existing-files list and each
         file's Προβολή (view/download) button stay visible either way,
         since "view appointment details" is explicitly what
         appointment-view is meant to allow. -->
    <div class="file-upload-section{{(isset($files) && count($files) > 0) ? ' is-expanded' : ''}}">
        <h5 class="file-upload-section-heading" data-toggle-attachments>
            <i class='bx bx-chevron-right toggle-icon'></i>
            <span>{{{t('Attached files')}}}</span>
            {% if(isset($files) && count($files) > 0): %}
            <span class="file-count-badge">{{count($files)}}</span>
            {% endif %}
        </h5>

        <div class="file-upload-section-body">
            {% if($can_edit): %}
            <form class="file-upload-form" enctype="multipart/form-data"
                data-upload-url="{{rel_url('/appointment/' . $appointment->getid() . '/files')}}">
                <div class="file-upload-area" data-dropzone>
                    <input type="file" id="file-upload-{{$index}}" name="appointmentFile" multiple accept="image/*,.pdf" class="file-input">
                    <label for="file-upload-{{$index}}" class="file-upload-label">
                        <i class='bx bx-cloud-upload'></i>
                        <span>{{{t('Choose or drop files here')}}}</span>
                    </label>
                </div>
            </form>

            <div class="clipboard-paste-row">
                <button type="button" class="paste-clipboard-btn" data-paste-clipboard>
                    <i class='bx bx-clipboard'></i> {{{t('Paste an image from the clipboard')}}}
                </button>
                <input type="text" class="paste-description-input" data-paste-description
                    placeholder="{{{t('Description (optional)')}}}" maxlength="255">
                <span class="paste-status" data-paste-status></span>
            </div>
            {% endif %}

            <!-- Local previews for in-progress uploads -->
            <div class="file-previews" id="file-previews-{{$index}}">
            </div>

            <!-- Existing uploaded files -->
            <div class="existing-files" id="existing-files-{{$index}}">
                {% if(!isset($files) || count($files) == 0): %}
                <p class="no-files">{{{t('There are no attached files')}}}</p>
                {% else: %}
                {% foreach($files as $f): %}
                <div class="file-item" data-file-id="{{$f->getid()}}">
                    <div class="file-preview-trigger">
                        {% if(str_starts_with($f->getmime_type(), 'image/')): %}
                        <div class="file-preview">
                            <img src="{{rel_url('/appointment/' . $appointment->getid() . '/files/' . $f->getid() . '/thumbnail')}}" alt="{{{$f->getfile_name()}}}">
                        </div>
                        <div class="file-preview-popup">
                            <img src="{{rel_url('/appointment/' . $appointment->getid() . '/files/' . $f->getid() . '/thumbnail')}}" alt="{{{$f->getfile_name()}}}">
                        </div>
                        {% else: %}
                        <div class="file-preview pdf-preview">
                            <i class='bx bxs-file-pdf'></i>
                        </div>
                        {% endif %}
                    </div>
                    <div class="file-info">
                        <span class="file-name">{{{$f->getfile_name()}}}</span>
                        <span class="file-size">{{appointment_files_format_size($f->getfile_size())}}</span>
                        {% if($f->getdescription()): %}
                        <span class="file-description">{{{$f->getdescription()}}}</span>
                        {% endif %}
                    </div>
                    <div class="file-actions">
                        <button type="button" class="view-btn"
                            data-file="{{rel_url('/appointment/' . $appointment->getid() . '/files/' . $f->getid() . '/download')}}">{{{t('View')}}}</button>
                        {% if($can_edit): %}
                        <button type="button" class="delete-btn"
                            data-delete-url="{{rel_url('/appointment/' . $appointment->getid() . '/files/' . $f->getid() . '/delete')}}">{{{t('Delete')}}}</button>
                        {% endif %}
                    </div>
                </div>
                {% endforeach %}
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Per-appointment edit history used to live here, one
         .appointment-history-section per card -- moved to a single,
         patient-level section on edit_patient.zetem instead (see that
         template and zpms_patient_appointment_history_for_display() in
         web/appointment_history.php): a patient's edit history is one
         continuous record of who touched their file and when, not
         something that should fragment into a separate, easy-to-miss
         list per appointment card. -->
</div>
