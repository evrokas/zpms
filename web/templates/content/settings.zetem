{#
  settings.zetem -- reference lists (clinics, doctors), the notification
  email's SMTP settings, and links to user/role management.

  $clinics_table / $doctors_table and $clinics / $doctors are rendered by
  zeusfw's generic webform engine (formsClass::renderFormResults() /
  renderForm(..., 'view_add')); their labels and buttons come from
  web/classes/yaml/{clinics,doctors}.yaml via the `webforms` DB table, so
  a label change there needs `maker.php form:load` (bin/update.sh's
  "Updating webforms" step) before it shows here.
#}
<div class="settings-page" lang="el">
    <div class="patients-header">
        <h2 class="page-title">Ρυθμίσεις</h2>
    </div>

    <nav class="settings-jump" aria-label="Ενότητες ρυθμίσεων">
        <a href="#settings-clinics"><i class="bx bx-clinic"></i> Κλινικές</a>
        <a href="#settings-doctors"><i class="bx bx-plus-medical"></i> Ιατροί</a>
        <a href="#settings-email"><i class="bx bx-envelope"></i> Email</a>
        {% if($show_user_management): %}
        <a href="#settings-users"><i class="bx bx-group"></i> Χρήστες &amp; ρόλοι</a>
        {% endif %}
    </nav>

    <section class="settings-section" id="settings-clinics">
        <header class="settings-section-header">
            <span class="settings-section-icon"><i class="bx bx-clinic"></i></span>
            <div>
                <h3>Κλινικές</h3>
                <p>Οι κλινικές από τις οποίες επιλέγετε στις φόρμες της εφαρμογής.</p>
            </div>
        </header>
        <div class="settings-table-scroll">{{$clinics_table}}</div>
        <div class="settings-add">
            <h4>Νέα κλινική</h4>
            {{$clinics}}
        </div>
    </section>

    <section class="settings-section" id="settings-doctors">
        <header class="settings-section-header">
            <span class="settings-section-icon"><i class="bx bx-plus-medical"></i></span>
            <div>
                <h3>Ιατροί</h3>
                <p>Λίστα ιατρών με την ειδικότητά τους, για τις επιλογές των φορμών.</p>
            </div>
        </header>
        <div class="settings-table-scroll">{{$doctors_table}}</div>
        <div class="settings-add">
            <h4>Νέος ιατρός</h4>
            {{$doctors}}
        </div>
    </section>

    <section class="settings-section" id="settings-email">
        <header class="settings-section-header">
            <span class="settings-section-icon"><i class="bx bx-envelope"></i></span>
            <div>
                <h3>Email ειδοποιήσεων (SMTP)</h3>
                <p>Ο λογαριασμός από τον οποίο στέλνεται το email όταν ένα ραντεβού ανατίθεται σε ιατρό.</p>
            </div>
        </header>

        {% if(!$mail_settings): %}
        <div class="settings-section-body">
            <p class="settings-notice">
                Οι ρυθμίσεις email δεν έχουν ενεργοποιηθεί ακόμη. Εκτελέστε
                <code>php bin/migrate_appointment_email.php --yes</code> στον διακομιστή.
            </p>
        </div>
        {% else: %}
        <form class="settings-form" action="{{rel_url('/settings/mail')}}" method="post">
            {{ csrf_field() }}

            <div class="settings-fields">
                <div class="settings-field settings-field-wide">
                    <label for="smtp_host">Διακομιστής SMTP</label>
                    <input type="text" name="smtp_host" id="smtp_host" value="{{{$mail_settings->getsmtp_host()}}}" placeholder="π.χ. smtp.example.gr">
                </div>

                <div class="settings-field">
                    <label for="smtp_port">Θύρα</label>
                    <input type="text" name="smtp_port" id="smtp_port" inputmode="numeric" value="{{{$mail_settings->getsmtp_port()}}}" placeholder="587">
                </div>

                <div class="settings-field">
                    <label for="smtp_encryption">Κρυπτογράφηση</label>
                    <select name="smtp_encryption" id="smtp_encryption">
                        {% $enc = $mail_settings->getsmtp_encryption() ?: 'tls'; %}
                        <option value="tls" {{($enc == 'tls')?'selected':''}}>TLS (STARTTLS)</option>
                        <option value="ssl" {{($enc == 'ssl')?'selected':''}}>SSL</option>
                        <option value="none" {{($enc == 'none')?'selected':''}}>Καμία</option>
                    </select>
                </div>

                <div class="settings-field">
                    <label for="smtp_username">Όνομα χρήστη</label>
                    <input type="text" name="smtp_username" id="smtp_username" value="{{{$mail_settings->getsmtp_username()}}}" autocomplete="off">
                </div>

                <div class="settings-field">
                    <label for="smtp_password">Κωδικός</label>
                    <input type="password" name="smtp_password" id="smtp_password" value="" placeholder="{{($mail_settings->getsmtp_password())?'(αμετάβλητος)':''}}" autocomplete="new-password">
                    <small>Αφήστε το κενό για να παραμείνει ο τρέχων κωδικός.</small>
                </div>

                <div class="settings-field">
                    <label for="from_email">Email αποστολέα</label>
                    <input type="text" name="from_email" id="from_email" value="{{{$mail_settings->getfrom_email()}}}" placeholder="π.χ. pms@example.gr">
                </div>

                <div class="settings-field">
                    <label for="from_name">Όνομα αποστολέα</label>
                    <input type="text" name="from_name" id="from_name" value="{{{$mail_settings->getfrom_name()}}}">
                </div>
            </div>

            <div class="settings-form-actions">
                <button type="submit"><i class="bx bx-save"></i> Αποθήκευση</button>
            </div>
        </form>
        {% endif %}
    </section>

    {% if($show_user_management): %}
    <section class="settings-section" id="settings-users">
        <header class="settings-section-header">
            <span class="settings-section-icon"><i class="bx bx-group"></i></span>
            <div>
                <h3>Χρήστες &amp; ρόλοι</h3>
                <p>Λογαριασμοί, ρόλοι και τι επιτρέπεται σε κάθε ρόλο.</p>
            </div>
        </header>
        <div class="settings-links">
            <a href="{{rel_url('/admin/users')}}">
                <i class="bx bx-user"></i>
                <span><strong>Χρήστες</strong><small>Λογαριασμοί και οι ρόλοι τους</small></span>
            </a>
            <a href="{{rel_url('/admin/roles')}}">
                <i class="bx bx-id-card"></i>
                <span><strong>Ρόλοι</strong><small>Ιατρός, Γραμματεία, …</small></span>
            </a>
            <a href="{{rel_url('/admin/permissions')}}">
                <i class="bx bx-key"></i>
                <span><strong>Δικαιώματα</strong><small>Οι ενέργειες που μπορούν να επιτραπούν</small></span>
            </a>
            <a href="{{rel_url('/admin/role_permissions')}}">
                <i class="bx bx-shield-quarter"></i>
                <span><strong>Δικαιώματα ρόλων</strong><small>Ποιος ρόλος μπορεί να κάνει τι</small></span>
            </a>
            <a href="{{rel_url('/admin/user_roles')}}">
                <i class="bx bx-user-check"></i>
                <span><strong>Ρόλοι χρηστών</strong><small>Ανάθεση ρόλων ανά χρήστη</small></span>
            </a>
        </div>
    </section>
    {% endif %}
</div>
