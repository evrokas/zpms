{% attach_library('schedule-setup') %}
{#
  settings.zetem -- reference lists (clinics, doctors), the notification
  email's SMTP settings, and links to user/role management.

  $clinics_table / $doctors_table and $clinics / $doctors are rendered by
  zeusfw's generic webform engine (formsClass::renderFormResults() /
  renderForm(..., 'view_add')); their labels and buttons come from
  web/classes/yaml/{clinics,doctors}.yaml via the `webforms` DB table, so
  a label change there needs `maker.php form:load` (bin/update.sh's
  "Updating webforms" step) before it shows here.
#}
<div class="settings-page" lang="el">
    <div class="patients-header">
        {# Visually hidden: the breadcrumb above already names this page. Kept as the
           page heading for screen readers. #}
        <h2 class="page-title sr-only">{{{t('Settings')}}}</h2>
    </div>

    <nav class="settings-jump" aria-label="{{{t('Settings sections')}}}">
        <a href="#settings-clinics"><i class="bx bx-clinic"></i> {{{t('Clinics')}}}</a>
        <a href="#settings-doctors"><i class="bx bx-plus-medical"></i> {{{t('Doctors')}}}</a>
        {% if($schedule_setup): %}
        <a href="#settings-schedule"><i class="bx bx-calendar"></i> {{{t('Appointment schedule')}}}</a>
        {% endif %}
        <a href="#settings-email"><i class="bx bx-envelope"></i> {{{t('Email')}}}</a>
        {% if($show_user_management): %}
        <a href="#settings-users"><i class="bx bx-group"></i> {{{t('Users & roles')}}}</a>
        {% endif %}
    </nav>

    <section class="settings-section" id="settings-clinics">
        <header class="settings-section-header">
            <span class="settings-section-icon"><i class="bx bx-clinic"></i></span>
            <div>
                <h3>{{{t('Clinics')}}}</h3>
                <p>{{{t('The clinics you choose from in the application forms.')}}}</p>
            </div>
        </header>
        <div class="settings-table-scroll">{{$clinics_table}}</div>
        <div class="settings-add">
            <h4>{{{t('New clinic')}}}</h4>
            {{$clinics}}
        </div>
    </section>

    <section class="settings-section" id="settings-doctors">
        <header class="settings-section-header">
            <span class="settings-section-icon"><i class="bx bx-plus-medical"></i></span>
            <div>
                <h3>{{{t('Doctors')}}}</h3>
                <p>{{{t('The list of doctors with their specialty, for the form choices.')}}}</p>
            </div>
        </header>
        <div class="settings-table-scroll">{{$doctors_table}}</div>
        <div class="settings-add">
            <h4>{{{t('New doctor')}}}</h4>
            {{$doctors}}
        </div>
    </section>

    {% if($schedule_setup): %}
    <section class="settings-section" id="settings-schedule">
        <header class="settings-section-header">
            <span class="settings-section-icon"><i class="bx bx-calendar"></i></span>
            <div>
                <h3>{{{t('Appointment schedule setup')}}}</h3>
                <p>{{{t('Where appointments can be made, the weekly program of each location and the travel times between them.')}}}</p>
            </div>
        </header>

        <script type="application/json" id="schedule-setup-data">{{ $schedule_setup_json }}</script>

        <form method="post" action="{{rel_url('/settings/schedule-locations')}}" class="sched-locs">
            {{csrf_field()}}
            <h4>{{{t('Locations that take appointments')}}}</h4>
            <p class="sched-sub">{{{t('Switching a location off only stops new appointments there. Its weekly program and the appointments already made are kept, and show again when you switch it back on.')}}}</p>
            {% foreach($schedule_setup['locations'] as $l): %}
            <label class="sched-loc-check">
                <input type="checkbox" name="enabled[]" value="{{{$l['code']}}}" {{($l['enabled']) ? 'checked' : ''}}> {{{$l['name']}}}
            </label>
            {% endforeach %}
            <div class="settings-form-actions">
                <button type="submit"><i class="bx bx-save"></i> {{{t('Save')}}}</button>
            </div>
        </form>

        {% if($can_edit_schedule): %}
        <div class="sched-setup-buttons">
            <button type="button" class="sched-btn" id="sched-open-pattern"><i class="bx bx-repeat"></i> {{{t('Weekly pattern')}}}</button>
            <button type="button" class="sched-btn" id="sched-open-travel"><i class="bx bx-car"></i> {{{t('Travel times')}}}</button>
            <a class="sched-btn" href="{{rel_url('/schedule')}}"><i class="bx bx-calendar-week"></i> {{{t('Appointment schedule')}}}</a>
        </div>

        <dialog class="sched-dialog" id="sched-pattern">
    <h3>{{{t('Weekly pattern')}}}</h3>
    <label class="sched-field">{{{t('Location')}}} <select id="sched-pattern-loc-select"></select></label>
    <p class="sched-sub">{{{t('Repeats every week. To change a single date, drag on the calendar instead.')}}}</p>
    <label class="sched-field">{{{t('Applies from')}}}
        <input type="text" id="sched-valid-from" autocomplete="off" placeholder="{{{t('yyyy-mm-dd, empty = today')}}}">
    </label>
    <p class="sched-sub" id="sched-pattern-since"></p>
    <div class="sched-scroll">
        <table class="sched-table">
            <thead><tr>
                <th>{{{t('Day')}}}</th><th>{{{t('From')}}}</th><th>{{{t('To')}}}</th><th>{{{t('Type')}}}</th>
                <th>{{{t('Slot (min)')}}}</th><th>{{{t('Reason')}}}</th><th></th>
            </tr></thead>
            <tbody id="sched-pattern-rows"></tbody>
        </table>
    </div>
    <p><button type="button" class="sched-btn" id="sched-pattern-add">+ {{{t('Add interval')}}}</button></p>
    <div id="sched-pattern-msg"></div>
    <details class="sched-history" id="sched-pattern-history" hidden>
        <summary>{{{t('Earlier versions of the pattern')}}}</summary>
        <div id="sched-pattern-history-body"></div>
    </details>
    <div class="sched-foot">
        <button type="button" class="sched-btn" data-close>{{{t('Cancel')}}}</button>
        <button type="button" class="sched-btn pri" id="sched-pattern-save">{{{t('Save pattern')}}}</button>
    </div>
</dialog>

<dialog class="sched-dialog" id="sched-travel">
    <h3>{{{t('Travel times')}}}</h3>
    <p class="sched-sub">{{{t('Minutes the doctor needs between two locations. The phone / online location needs none unless you set it.')}}}</p>
    <div class="sched-scroll"><table class="sched-table" id="sched-travel-table"></table></div>
    <label class="sched-check"><input type="checkbox" id="sched-travel-sym" checked> {{{t('A change applies in both directions')}}}</label>
    <div id="sched-travel-msg"></div>
    <div class="sched-foot">
        <button type="button" class="sched-btn" data-close>{{{t('Cancel')}}}</button>
        <button type="button" class="sched-btn pri" id="sched-travel-save">{{{t('Save')}}}</button>
    </div>
</dialog>

        {% endif %}
    </section>
    {% endif %}

    <section class="settings-section" id="settings-email">
        <header class="settings-section-header">
            <span class="settings-section-icon"><i class="bx bx-envelope"></i></span>
            <div>
                <h3>{{{t('Notification email (SMTP)')}}}</h3>
                <p>{{{t('The account the email is sent from when an appointment is assigned to a doctor.')}}}</p>
            </div>
        </header>

        {% if(!$mail_settings): %}
        <div class="settings-section-body">
            <p class="settings-notice">
                {{t('The email settings have not been enabled yet. Run @command on the server.', ['command' => '<code>php bin/migrate_appointment_email.php --yes</code>'])}}
            </p>
        </div>
        {% else: %}
        <form class="settings-form" action="{{rel_url('/settings/mail')}}" method="post">
            {{ csrf_field() }}

            <div class="settings-fields">
                <div class="settings-field settings-field-wide">
                    <label for="smtp_host">{{{t('SMTP server')}}}</label>
                    <input type="text" name="smtp_host" id="smtp_host" value="{{{$mail_settings->getsmtp_host()}}}" placeholder="{{{t('e.g. smtp.example.com')}}}">
                </div>

                <div class="settings-field">
                    <label for="smtp_port">{{{t('Port')}}}</label>
                    <input type="text" name="smtp_port" id="smtp_port" inputmode="numeric" value="{{{$mail_settings->getsmtp_port()}}}" placeholder="587">
                </div>

                <div class="settings-field">
                    <label for="smtp_encryption">{{{t('Encryption')}}}</label>
                    <select name="smtp_encryption" id="smtp_encryption">
                        {% $enc = $mail_settings->getsmtp_encryption() ?: 'tls'; %}
                        <option value="tls" {{($enc == 'tls')?'selected':''}}>TLS (STARTTLS)</option>
                        <option value="ssl" {{($enc == 'ssl')?'selected':''}}>SSL</option>
                        <option value="none" {{($enc == 'none')?'selected':''}}>{{{t('None')}}}</option>
                    </select>
                </div>

                <div class="settings-field">
                    <label for="smtp_username">{{{t('SMTP username')}}}</label>
                    <input type="text" name="smtp_username" id="smtp_username" value="{{{$mail_settings->getsmtp_username()}}}" autocomplete="off">
                </div>

                <div class="settings-field">
                    <label for="smtp_password">{{{t('SMTP password')}}}</label>
                    <input type="password" name="smtp_password" id="smtp_password" value="" placeholder="{{{($mail_settings->getsmtp_password()) ? t('(unchanged)') : ''}}}" autocomplete="new-password">
                    <small>{{{t('Leave blank to keep the current password.')}}}</small>
                </div>

                <div class="settings-field">
                    <label for="from_email">{{{t('Sender email')}}}</label>
                    <input type="text" name="from_email" id="from_email" value="{{{$mail_settings->getfrom_email()}}}" placeholder="{{{t('e.g. pms@example.com')}}}">
                </div>

                <div class="settings-field">
                    <label for="from_name">{{{t('Sender name')}}}</label>
                    <input type="text" name="from_name" id="from_name" value="{{{$mail_settings->getfrom_name()}}}">
                </div>
            </div>

            <div class="settings-form-actions">
                <button type="submit"><i class="bx bx-save"></i> {{{t('Save')}}}</button>
            </div>
        </form>
        {% endif %}
    </section>

    {% if($show_user_management): %}
    <section class="settings-section" id="settings-users">
        <header class="settings-section-header">
            <span class="settings-section-icon"><i class="bx bx-group"></i></span>
            <div>
                <h3>{{{t('Users & roles')}}}</h3>
                <p>{{{t('Accounts, roles and what each role is allowed to do.')}}}</p>
            </div>
        </header>
        <div class="settings-links">
            <a href="{{rel_url('/admin/users')}}">
                <i class="bx bx-user"></i>
                <span><strong>{{{t('Users')}}}</strong><small>{{{t('Accounts and their roles')}}}</small></span>
            </a>
            <a href="{{rel_url('/admin/roles')}}">
                <i class="bx bx-id-card"></i>
                <span><strong>{{{t('Roles')}}}</strong><small>{{{t('Doctor, Secretary, ...')}}}</small></span>
            </a>
            <a href="{{rel_url('/admin/permissions')}}">
                <i class="bx bx-key"></i>
                <span><strong>{{{t('Permissions')}}}</strong><small>{{{t('The actions that can be allowed')}}}</small></span>
            </a>
            <a href="{{rel_url('/admin/role_permissions')}}">
                <i class="bx bx-shield-quarter"></i>
                <span><strong>{{{t('Role permissions')}}}</strong><small>{{{t('Which role can do what')}}}</small></span>
            </a>
            <a href="{{rel_url('/admin/user_roles')}}">
                <i class="bx bx-user-check"></i>
                <span><strong>{{{t('User roles')}}}</strong><small>{{{t('Assign roles per user')}}}</small></span>
            </a>
        </div>
    </section>
    {% endif %}
</div>
