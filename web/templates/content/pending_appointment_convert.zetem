{% attach_library('loader-library'); %}
{% attach_library('boxicons') %}
{% attach_library('pending-convert') %}
{#
  pending_appointment_convert.zetem -- /consultation/pending/{id}/convert:
  the patient of a pending booking has arrived; make the appointment, on an
  existing record or a new one.

  From pending_appointment_convert() in web/index.php: $pending, $candidates
  (possible existing patients, best first: see
  patientsClassEx::findConversionCandidates()), $candidates_json, $selected
  (the strong match picked to start with, or null), $booking_when.

  web/js/pending-convert.js re-checks the candidates as the details change
  and asks before saving: "add to this existing record?" or "is it one of
  these patients, or a new one?". The server refuses to create a new record
  while candidates exist without that answer (confirm-new=1).
#}

<div class="edit-patient pc-page" id="pc-page"
     data-candidates="{{{$candidates_json}}}"
     data-candidates-url="{{{rel_url('/consultation/pending/'.$pending->getid().'/convert/candidates')}}}"
     data-booking-name="{{{$pending->getpatient_name()}}}"
     data-booking-when="{{{$booking_when}}}"
     data-booking-place="{{{(string)$pending->getlocation()}}}">
    <h2 class="sr-only">{{{t('Create patient record')}}}</h2>

    <div class="pc-booking">
        <span class="pc-booking-icon" aria-hidden="true"><i class="bx bx-calendar-check"></i></span>
        <div>
            <div class="pc-booking-title">{{{t('Appointment')}}}: <b>{{{$booking_when}}}</b>{% if($pending->getlocation()): %} &middot; {{{$pending->getlocation()}}}{% endif %}</div>
            <div class="pc-booking-sub">{{{t('Name on the booking')}}}: <b>{{{$pending->getpatient_name()}}}</b>{% if($pending->getpatient_phone()): %} &middot; {{{$pending->getpatient_phone()}}}{% endif %}</div>
        </div>
    </div>

    <section class="pc-candidates" id="pc-candidates" aria-live="polite" {% if(count($candidates) == 0): %}hidden{% endif %}>
        <h3><i class="bx bx-user-check" aria-hidden="true"></i> {{{t('Possible existing patients')}}}</h3>
        <p class="pc-hint">{{{t('If the patient is already on file, choose the record so the appointment is added there instead of creating a second record.')}}}</p>
        <ul class="pc-list" id="pc-list">
            {% foreach($candidates as $c): %}
            <li class="pc-card{{($selected && $selected['id'] === $c['id']) ? ' is-selected' : ''}}" data-id="{{$c['id']}}">
                <div class="pc-who">
                    <a class="pc-name" href="{{{$c['url']}}}" target="_blank" rel="noopener">{{{$c['name']}}}</a>
                    <div class="pc-sub">
                        {% if($c['amka'] !== ''): %}<span>{{{t('AMKA')}}} {{{$c['amka']}}}</span>{% endif %}
                        {% if($c['phone'] !== ''): %}<span>{{{$c['phone']}}}</span>{% endif %}
                        {% if($c['dob'] !== ''): %}<span>{{{$c['dob']}}} ({{t('@age years old', ['age' => (int)$c['age']])}})</span>{% endif %}
                    </div>
                    <div class="pc-sub">
                        {% if($c['last']): %}<span><i class="bx bx-calendar" aria-hidden="true"></i> {{{t('Last appointment')}}}: {{{$c['last']['date']}}}{% if($c['last']['place'] !== ''): %} &middot; {{{$c['last']['place']}}}{% endif %} ({{(int)$c['appointments']}})</span>
                        {% else: %}<span>{{{t('No appointments yet')}}}</span>{% endif %}
                    </div>
                    <div class="pc-reasons">
                        {% foreach($c['reason_labels'] as $why => $label): %}<span class="pc-reason is-{{{$why}}}">{{{$label}}}</span>{% endforeach %}
                    </div>
                </div>
                <button type="button" class="pc-use" data-id="{{$c['id']}}">{{{t('This is the patient')}}}</button>
            </li>
            {% endforeach %}
        </ul>
    </section>

    <form action="{{rel_url('/consultation/pending/'.$pending->getid().'/convert')}}" method="post" id="pc-form">
        {{ csrf_field() }}
        <input type="hidden" name="existing-patient-id" id="existing-patient-id" value="{{{$selected ? $selected['id'] : ''}}}">
        <input type="hidden" name="confirm-new" id="confirm-new" value="">

        <div class="pc-selected" id="pc-selected" hidden>
            <i class="bx bx-link" aria-hidden="true"></i>
            <span id="pc-selected-text"></span>
            <button type="button" id="pc-unselect">{{{t('Cancel (new patient)')}}}</button>
        </div>

        <div class="input-div">
            <label for="convert-patient-name">{{{t('Patient name')}}}</label>
            <input type="text" name="patient-name" id="convert-patient-name"
                value="{{{$pending->getpatient_name()}}}" autocomplete="off" required>
        </div>

        <div class="input-div">
            <label for="convert-patient-telephone">{{{t('Telephone')}}}</label>
            <input type="text" name="patient-telephone" id="convert-patient-telephone" value="{{{$pending->getpatient_phone()}}}" autocomplete="off">
        </div>

        <div class="input-div">
            <label for="convert-patient-amka">{{{t('AMKA')}}}</label>
            <input type="text" name="patient-amka" id="convert-patient-amka" value="{{{$pending->getpatient_amka()}}}" autocomplete="off">
        </div>

        <div class="input-div">
            <label for="convert-patient-email">{{{t('Email')}}}</label>
            <input type="text" name="patient-email" id="convert-patient-email" value="{{{$pending->getpatient_email()}}}" autocomplete="off">
        </div>

        <div class="buttons">
            <input type="submit" id="pc-submit" value="{{{t('Create record & appointment')}}}">
        </div>
    </form>

    <dialog class="pc-dialog" id="pc-dialog" aria-labelledby="pc-dialog-title">
        <form method="dialog" class="pc-dialog-inner">
            <h3 id="pc-dialog-title"></h3>
            <div id="pc-dialog-body"></div>
            <div class="pc-dialog-buttons" id="pc-dialog-buttons"></div>
        </form>
    </dialog>
</div>
