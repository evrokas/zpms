{% attach_library('loader-library'); %}

<div class="edit-patient">
    {# Visually hidden: the breadcrumb above already names this page. Kept as the
       page heading for screen readers. #}
    <h2 class="sr-only">{{{t('Create patient record')}}}</h2>

    <p class="muted page-intro">
        {{{t('Appointment')}}}: {{$pending->getappointment_datetime() | date('d-m-Y H:i')}}
        {% if($pending->getlocation()): %} &middot; {{{$pending->getlocation()}}}{% endif %}
    </p>

    <form action="{{rel_url('/consultation/pending/'.$pending->getid().'/convert')}}" method="post">
        {{ csrf_field() }}
        <input type="hidden" name="existing-patient-id" id="existing-patient-id" value="{{{$matched_patient ? $matched_patient->getid() : ''}}}">

        <div class="input-div">
            <label for="patient-name">{{{t('Patient name')}}}</label>
            <input type="text" name="patient-name" id="convert-patient-name"
                value="{{{$matched_patient ? $matched_patient->getpname() : $pending->getpatient_name()}}}"
                autocomplete="off" required {% if($matched_patient): %}readonly{% endif %}>
        </div>

        <div class="duplicate-warning" id="convert-duplicate-warning" {% if(!$matched_patient): %}style="display:none;"{% endif %}></div>

        <div class="input-div">
            <label for="patient-telephone">{{{t('Telephone')}}}</label>
            <input type="text" name="patient-telephone" id="convert-patient-telephone"
                value="{{{$matched_patient ? $matched_patient->getptel() : $pending->getpatient_phone()}}}"
                {% if($matched_patient): %}readonly{% endif %}>
        </div>

        <div class="input-div">
            <label for="patient-amka">{{{t('AMKA')}}}</label>
            <input type="text" name="patient-amka" id="convert-patient-amka"
                value="{{{$matched_patient ? $matched_patient->getpamka() : $pending->getpatient_amka()}}}"
                {% if($matched_patient): %}readonly{% endif %}>
        </div>

        <div class="input-div">
            <label for="patient-email">{{{t('Email')}}}</label>
            <input type="text" name="patient-email" id="convert-patient-email"
                value="{{{$matched_patient ? $matched_patient->getpemail() : $pending->getpatient_email()}}}"
                {% if($matched_patient): %}readonly{% endif %}>
        </div>

        <div class="buttons">
            <input type="submit" value="{{{t('Create record & appointment')}}}">
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var nameInput = document.getElementById('convert-patient-name');
        var phoneInput = document.getElementById('convert-patient-telephone');
        var amkaInput = document.getElementById('convert-patient-amka');
        var emailInput = document.getElementById('convert-patient-email');
        var warningBox = document.getElementById('convert-duplicate-warning');
        var existingIdInput = document.getElementById('existing-patient-id');
        /* Interface text comes from the dictionary (rendered here, not typed in the script). */
        var I18N = {{ json_encode(['found' => t('A patient record with these details already exists -- '), 'addTo' => t('The appointment will be added to the existing record:'), 'clear' => t('Cancel (new patient)'), 'similar' => t('Patients with a similar name were found -- choose if this is the same person:'), 'amka' => t('AMKA'), 'use' => t('Use this one')], JSON_HEX_TAG + JSON_HEX_AMP + JSON_UNESCAPED_UNICODE) }};
        var timeout;

        function escapeHtml(str) {
            return String(str).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        }

        function setLinkedFieldsReadonly(readonly) {
            nameInput.readOnly = readonly;
            phoneInput.readOnly = readonly;
            amkaInput.readOnly = readonly;
            emailInput.readOnly = readonly;
        }

        function clearExisting() {
            existingIdInput.value = '';
            setLinkedFieldsReadonly(false);
            warningBox.style.display = 'none';
            warningBox.innerHTML = '';
        }

        /* Used both for the server's own auto-match on page load (name,
         * then AMKA, then phone -- see patientsClassEx::findMatchingPatient()
         * in web/ClassesEx.php) and for a match the doctor picks by hand
         * from the live name-search suggestions below -- same end state
         * either way: existing-patient-id is set, and every field mirrors
         * that patient's own stored data (not whatever was typed on the
         * phone-booking screen) since that's what will actually be saved. */
        function useExisting(id, name, amka, phone, email, auto) {
            existingIdInput.value = id;
            nameInput.value = name;
            amkaInput.value = amka || '';
            phoneInput.value = phone || '';
            emailInput.value = email || '';
            setLinkedFieldsReadonly(true);

            warningBox.innerHTML = '<p>'
                + (auto ? escapeHtml(I18N.found) : '')
                + escapeHtml(I18N.addTo) + ' <b>' + escapeHtml(name) + '</b> '
                + '&mdash; <button type="button" id="clear-existing">' + escapeHtml(I18N.clear) + '</button></p>';
            warningBox.style.display = 'block';
            document.getElementById('clear-existing').addEventListener('click', clearExisting);
        }

        function renderSuggestions(matches) {
            // A match is already selected (auto or manual) -- a fresh
            // keystroke's suggestion list must never silently replace it.
            if (existingIdInput.value !== '') return;

            if (!matches || matches.length === 0) {
                warningBox.style.display = 'none';
                warningBox.innerHTML = '';
                return;
            }
            var html = '<p>' + escapeHtml(I18N.similar) + '</p><ul>';
            matches.forEach(function(m) {
                html += '<li>'
                    + '<span class="name">' + escapeHtml(m.name) + '</span>'
                    + '<span class="amka">' + escapeHtml(I18N.amka) + ': ' + escapeHtml(m.amka || '—') + '</span>'
                    + '<button type="button" class="use-existing" data-id="' + escapeHtml(m.id)
                    + '" data-name="' + escapeHtml(m.name) + '" data-amka="' + escapeHtml(m.amka || '')
                    + '" data-phone="' + escapeHtml(m.phone || '') + '" data-email="' + escapeHtml(m.email || '')
                    + '">' + escapeHtml(I18N.use) + '</button>'
                    + '</li>';
            });
            html += '</ul>';
            warningBox.innerHTML = html;
            warningBox.style.display = 'block';

            warningBox.querySelectorAll('.use-existing').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    useExisting(btn.dataset.id, btn.dataset.name, btn.dataset.amka, btn.dataset.phone, btn.dataset.email, false);
                });
            });
        }

        {% if($matched_patient): %}
        // Pre-selected server-side (see pending_appointment_convert() in
        // web/index.php) -- rendered directly rather than re-fetched here,
        // so the page shows the correct linked-record state even before
        // this script has a chance to run.
        useExisting(
            {{ json_encode($matched_patient->getid()) }},
            {{ json_encode($matched_patient->getpname()) }},
            {{ json_encode($matched_patient->getpamka()) }},
            {{ json_encode($matched_patient->getptel()) }},
            {{ json_encode($matched_patient->getpemail()) }},
            true
        );
        {% endif %}

        nameInput.addEventListener('input', function(ev) {
            if (existingIdInput.value !== '') return;
            clearTimeout(timeout);
            var term = ev.target.value.trim();
            if (term.length < 2) {
                renderSuggestions([]);
                return;
            }
            timeout = setTimeout(function() {
                fetch(window.location.pathname.replace(/\/?$/, '/') + 'namecheck', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'pname=' + encodeURIComponent(term)
                })
                    .then(r => r.json())
                    .then(data => renderSuggestions(data.matches))
                    .catch(() => {});
            }, 300);
        });
    });
</script>
