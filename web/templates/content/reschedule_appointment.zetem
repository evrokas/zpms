{% attach_library('appointment-improvements') %}
{% attach_library('flatpickr-library') %}
{% attach_library('booking-picker') %}

{# Visually hidden: the breadcrumb already names the page. #}
<h2 class="sr-only">{{{t('Reschedule the appointment')}}}</h2>

<div class="appointment-patient-name">
    <h4>{{{t('Patient')}}}: <span>{{{$patient_name}}}</span></h4>
</div>

<div class="appointment-entry">
    <form action="{{{$action}}}" method="post">
        {{ csrf_field() }}
        <div class="input-header">
            {{ $booking_picker }}
        </div>
        <div class="buttons">
            <input type="submit" name="submit" value="{{{t('Save')}}}">
            <input type="submit" name="cancel" value="{{{t('Cancel')}}}">
        </div>
    </form>
</div>
