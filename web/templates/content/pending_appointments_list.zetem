{% attach_library('boxicons') %}

<div class="patients-header">
    {# Visually hidden: the breadcrumb above already names this page. Kept as the
           page heading for screen readers. #}
        <h2 class="page-title sr-only">{{{t('Pending appointments')}}}</h2>
    <a class="btn-add-patient" href="{{rel_url('/consultation/new')}}">
        <i class="bx bx-plus"></i>{{{t('New appointment')}}}
    </a>
</div>

<div class="pending-appointments-list" lang="el">
{% if(count($pending) == 0): %}
    <div class="patients-empty">
        <i class="bx bx-calendar"></i>
        <p>{{{t('There are no pending appointments.')}}}</p>
    </div>
{% else: %}
    <table>
        <thead>
            <th>{{{t('Name')}}}</th>
            <th>{{{t('Telephone')}}}</th>
            <th>{{{t('Location')}}}</th>
            <th>{{{t('Date & time')}}}</th>
            <th>{{{t('Calendar')}}}</th>
            <th>{{{t('Actions')}}}</th>
        </thead>
        <tbody>
            {% foreach($pending as $p): %}
            <tr>
                <td data-column="name">{{{$p->getpatient_name()}}}</td>
                <td data-column="phone">{{{$p->getpatient_phone() ?: '-'}}}</td>
                <td data-column="location">{{{$p->getlocation() ?: '-'}}}</td>
                <td data-column="datetime">{{$p->getappointment_datetime() | date('d-m-Y H:i')}}</td>
                <td data-column="synced">
                    {% if($p->getgoogle_event_id()): %}
                        <span class="sync-status is-synced" title="{{{t('Synced')}}}"><i class="bx bx-check"></i></span>
                    {% else: %}
                        <span class="sync-status is-unsynced" title="{{{t('Not synced')}}}"><i class="bx bx-x"></i></span>
                    {% endif %}
                </td>
                <td class="actions" data-column="actions">
                    <a class="icon-btn" href="{{rel_url('/consultation/pending/'.$p->getid().'/edit')}}" title="{{{t('Edit')}}}"><i class="bx bx-edit"></i></a>

                    {% if($can_convert): %}
                    <a class="icon-btn" href="{{rel_url('/consultation/pending/'.$p->getid().'/convert')}}" title="{{{t('Create patient record')}}}"><i class="bx bx-user-plus"></i></a>
                    {% endif %}

                    <form class="inline-delete-form" method="post" action="{{rel_url('/consultation/pending/'.$p->getid().'/delete')}}" confirmation>
                        {{ csrf_field() }}
                        <button type="submit" class="icon-btn icon-btn-danger" title="{{{t('Cancel')}}}"><i class="bx bx-trash"></i></button>
                    </form>
                </td>
            </tr>
            {% endforeach %}
        </tbody>
    </table>
{% endif %}
</div>

<div class="patients-header">
    <h2 class="page-title">{{{t('Previous appointments')}}}</h2>
</div>

<div class="previous-appointments-list" lang="el">
{% if(count($previous) == 0): %}
    <div class="patients-empty">
        <i class="bx bx-history"></i>
        <p>{{{t('There are no previous appointments.')}}}</p>
    </div>
{% else: %}
    <table>
        <thead>
            <th>{{{t('Date & time')}}}</th>
            <th>{{{t('Name')}}}</th>
            <th>{{{t('Telephone')}}}</th>
            <th>{{{t('Location')}}}</th>
            <th>{{{t('Actions')}}}</th>
        </thead>
        <tbody>
            {% foreach($previous as $p): %}
            <tr>
                <td data-column="datetime">{{$p->getappointment_datetime() | date('d-m-Y H:i')}}</td>
                <td data-column="name">
                    {% if($p->getconverted_patient_id()): %}
                    <a href="{{rel_url('/patient/'.$p->getconverted_patient_id().'/edit')}}">{{{$p->getpatient_name()}}}</a>
                    {% else: %}
                    {{{$p->getpatient_name()}}}
                    {% endif %}
                </td>
                <td data-column="phone">{{{$p->getpatient_phone() ?: '-'}}}</td>
                <td data-column="location">{{{$p->getlocation() ?: '-'}}}</td>
                <td class="actions" data-column="actions">
                    {% if(!$p->getconverted_patient_id()): %}
                    <a class="icon-btn" href="{{rel_url('/consultation/pending/'.$p->getid().'/edit')}}" title="{{{t('Reschedule')}}}"><i class="bx bx-calendar-edit"></i></a>
                    {% endif %}
                </td>
            </tr>
            {% endforeach %}
        </tbody>
    </table>
{% endif %}
</div>
