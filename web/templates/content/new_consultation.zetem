{% attach_library('loader-library'); %}
{% attach_library('flatpickr-library'); %}

<div class="edit-patient">
    {# Visually hidden: the breadcrumb above already names this page. Kept as the
       page heading for screen readers. #}
    <h2 class="sr-only">{{{t('New pending appointment (by phone)')}}}</h2>
    <p class="muted page-intro">
        {{{t('No patient record is created now -- only when the patient arrives will the doctor create the record from the Pending Appointments list.')}}}
    </p>

    {% if(!$calendar_enabled): %}
    <p class="muted page-notice">
        {{{t('Google Calendar is not configured -- the appointment will be saved in ZPMS as usual, without syncing.')}}}
    </p>
    {% endif %}

    <form action="/consultation/new" method="post">
        {{ csrf_field() }}

        <div class="input-div">
            <label for="patient-name">{{{t('Patient name')}}}</label>
            <input type="text" name="patient-name" id="consultation-patient-name" value="" placeholder="{{{t('Enter the patient name')}}}"
                data-check-duplicate="fill" data-check-duplicate-minlen="3"
                data-fill-target-phone="consultation-patient-telephone"
                data-fill-target-amka="consultation-patient-amka"
                data-fill-target-email="consultation-patient-email"
                autocomplete="off" required>
        </div>

        <div class="duplicate-warning" id="duplicate-warning" style="display:none;"></div>

        <div class="input-div">
            <label for="patient-telephone">{{{t('Telephone')}}}</label>
            <input type="text" name="patient-telephone" id="consultation-patient-telephone" value="" placeholder="{{{t('Enter the patient telephone')}}}" required>
        </div>

        <div class="input-div">
            <label for="patient-amka">{{{t('AMKA')}}}</label>
            <input type="text" name="patient-amka" id="consultation-patient-amka" value="" placeholder="{{{t('Enter the patient AMKA')}}}">
        </div>

        <div class="input-div">
            <label for="patient-email">{{{t('Email')}}}</label>
            <input type="text" name="patient-email" id="consultation-patient-email" value="" placeholder="{{{t('Enter the patient email (optional)')}}}">
        </div>

        <div class="input-div">
            <label for="appointment-date">{{{t('Appointment date & time')}}}</label>
            <input type="text" name="appointment-date" id="consultation-date" value="" required>
        </div>

        <div class="input-div">
            <label for="appointment-location">{{{t('Location')}}}</label>
            <select name="appointment-location" id="">
                <option value="">{{{t('-- Select a location --')}}}</option>
                {% foreach($locations as $loc): %}
                <option value="{{{$loc}}}">{{{$loc}}}</option>
                {% endforeach %}
            </select>
        </div>

        <div class="input-div">
            <label for="appointment-user">{{{t('Doctor')}}}</label>
            <select name="appointment-user" id="" required>
                <option value="">{{{t('-- Select a doctor --')}}}</option>
                {% foreach($doctors as $doctor): %}
                <option value="{{{$doctor['id']}}}" {{($doctor['id'] == $preselected_doctor_id)?'selected':''}}>{{{$doctor['name']}}}</option>
                {% endforeach %}
            </select>
        </div>

        <div class="input-div input-notes">
            <label for="appointment-notes">{{{t('Notes')}}}</label>
            <textarea name="appointment-notes" id="" rows="4"></textarea>
        </div>

        <div class="buttons">
            <input type="submit" name="submit" value="{{{t('Register')}}}">
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        flatpickr('#consultation-date', {
            enableTime: true,
            time_24hr: true,
            dateFormat: 'Y-m-d H:i',
            altInput: true,
            altFormat: 'd-m-Y H:i',
            allowInput: true,
            minDate: 'today'
        });
    });
</script>
