
{% attach_library('loader-library'); %}
{% attach_library('flatpickr-library'); %}
{% attach_library('patient-record'); %}

<div class="edit-patient{{($action == 'new') ? '' : ' is-record'}}">    
    {% if($action != 'new'): %}
    {# Way back to the list, above the title. t() with a language map: the text
       for the current language, so it follows the language switch (a language
       not listed falls back to the first one, English). #}
    <p class="page-back page-back-top">
        <a href="{{rel_url('/patients')}}"><i class="bx bx-arrow-back"></i> {{t(['en' => 'Back to patient list', 'gr' => 'Πίσω στη λίστα ασθενών'])}}</a>
    </p>
    {% endif %}
    <div class="header">
        <h4>{% if($action == 'new'): %}Νέος Ασθενής{% else: %}Επεξεργασία Στοιχείων Ασθενή{% endif %}</h4>
    </div>

    {% if($action != 'new'): %}
    <!-- Identity header: who this patient is, at a glance, with the
         editable details one click away instead of always taking the top
         of the page (the form below starts hidden). Everything here is
         read-only text rendered from the same patient row as the form;
         the small script at the bottom of this template keeps the text in
         step with the form while it is open (fields autosave). -->
    <section class="patient-identity" aria-label="Στοιχεία ασθενή">
        <div class="pi-main">
            <div class="pi-id">
                <div class="pi-avatar" aria-hidden="true">{{{$identity['initials']}}}</div>
                <div class="pi-who">
                    <h3 class="pi-name" id="pi-name">{{{$patient->getpname()}}}</h3>
                    <div class="pi-sub">
                        <span id="pi-gender" {% if($identity['gender'] === null): %}hidden{% endif %}>{{($identity['gender'] === 'F') ? 'Γυναίκα' : 'Άνδρας'}}</span>
                        <span id="pi-age" {% if($identity['age'] == ''): %}hidden{% endif %}>{{{$identity['age']}}}</span>
                        <span id="pi-dob" {% if(!$patient->getpdob()): %}hidden{% endif %}>{% if($patient->getpdob()): %}{{$patient->getpdob() | date('d-m-Y')}}{% endif %}</span>
                        <span class="pi-amka" id="pi-amka-wrap" {% if(!$patient->getpamka()): %}hidden{% endif %}>ΑΜΚΑ <span id="pi-amka">{{{$patient->getpamka()}}}</span>
                            <i class="bx bx-copy" id="pi-amka-copy" title="Αντιγραφή ΑΜΚΑ" data-copy-text="{{{$patient->getpamka()}}}"></i></span>
                    </div>
                </div>
            </div>

            <ul class="pi-contact">
                <li id="pi-tel-wrap" {% if(!$patient->getptel()): %}hidden{% endif %}><i class="bx bx-phone"></i><a id="pi-tel" href="tel:{{{$patient->getptel()}}}">{{{$patient->getptel()}}}</a></li>
                <li id="pi-email-wrap" {% if(!$patient->getpemail()): %}hidden{% endif %}><i class="bx bx-envelope"></i><a id="pi-email" href="mailto:{{{$patient->getpemail()}}}">{{{$patient->getpemail()}}}</a></li>
                <li id="pi-addr-wrap" {% if(!$patient->getpaddr()): %}hidden{% endif %}><i class="bx bx-map-pin"></i><span id="pi-addr">{{{$patient->getpaddr()}}}</span></li>
            </ul>

            <dl class="pi-stats">
                <div><dt>Ραντεβού</dt><dd>{{$identity['visits']}}</dd></div>
                <div><dt>Χειρουργεία</dt><dd>{{$identity['operations']}}</dd></div>
                {% if($identity['last']): %}<div><dt>Τελευταίο</dt><dd>{{$identity['last'] | date('d-m-Y')}}</dd></div>{% endif %}
                {% if($identity['next']): %}<div><dt>Επόμενο</dt><dd>{{$identity['next'] | date('d-m-Y')}}</dd></div>{% endif %}
            </dl>

            <button type="button" class="pi-toggle" id="patient-details-toggle" aria-expanded="false" aria-controls="patient-details"
                data-label-closed="{{($can_edit_patient) ? 'Επεξεργασία στοιχείων' : 'Στοιχεία ασθενή'}}"
                data-label-open="Κλείσιμο στοιχείων">
                <i class="bx bx-pencil"></i>
                <span>{{($can_edit_patient) ? 'Επεξεργασία στοιχείων' : 'Στοιχεία ασθενή'}}</span>
                <i class="bx bx-chevron-down pi-chevron"></i>
            </button>
        </div>
        <div class="pi-note" id="pi-note-wrap" {% if(!$patient->getpnote()): %}hidden{% endif %}>
            <i class="bx bx-note"></i><span id="pi-note">{{{$patient->getpnote()}}}</span>
        </div>
    </section>
    {% endif %}

    <div class="patient-details{{($action == 'new') ? ' is-new' : ''}}" id="patient-details" {% if($action != 'new'): %}hidden{% endif %}>
    <form action="{{$action}}" method="post">
        {{ csrf_field() }}

        <!-- A viewer with only patients-view-list (e.g. the secretary
             role -- see ZPMS_PERM_PATIENTS_VIEW_LIST's own docblock in
             web/rbac.php) reaches this page but can't save changes to
             it: every field below is wrapped in a single disabled
             <fieldset>, which disables every descendant form control at
             once (native HTML behavior) without touching each input
             individually. The submit buttons are separately hidden
             below, since a disabled fieldset doesn't hide its own
             submit controls, just makes them inert. -->
        <fieldset {% if(!$can_edit_patient): %}disabled{% endif %}>

        {#
            <div class="input-div">
            {% if($action != 'new'): %}
                <p>Patient GUID: {{$patient->getguid()}}
                </p>
            {% endif %}
            </div>
        #}

        <div class="pd-section pd-basic">
        <div class="pd-section-title"><i class="bx bx-user"></i> Βασικά Στοιχεία</div>

        <div class="input-div">
            <label for="patient-name">Όνομα ασθενή</label>
            <input type="text" name="patient-name" loader="info-loader" id="" value="{{{$patient->getpname()}}}" placeholder="όνομα ασθενούς"
                {% if($action == 'new'): %}data-check-duplicate="1" autocomplete="off"{% endif %}>

            <div class="inline-icons">
                <i class="bx bx-copy" data-copy-text="{{{$patient->getpname()}}}"></i>
            </div>
        </div>

        {% if($action == 'new'): %}
            <div class="duplicate-warning" id="duplicate-warning" style="display:none;"></div>
        {% endif %}
<!-- 
        <div class="input-div">
            <label for="patient-dob">Ημ/νια Γεννήσεως</label>
            <input type="datetime-local" name="patient-dob" id="" value="{{formatDate($patient->getpdob())}}">
            <input type="text" name="patient-dob" id="datepicker" value="{{$patient->getpdob()}}">
        </div>
    -->
        
        <!-- <div class="dob-field"> -->

            <div class="input-div">
                <label for="patient-dob">Ημ/νια Γεννήσεως</label>
                <!-- <input type="date" name="patient-dob" id="" value="{{formatDate($patient->getpdob())}}"> -->
                <input type="text" name="patient-dob" id="datepicker" loader="info-loader" value="{{$patient->getpdob()| date('Y-m-d')}}" agefield="age_field">
                
                <div class="inline-icons">
                    <!-- <i class='valid bx bx-check' style='color:#00ff00'  ></i> -->
                    <i class='not-valid bx bx-error' style='color:#ff0000'  ></i>
                    <span id="age_field" class="age-badge">Ηλικία</span>
                </div>

                <!-- <input type="text" style="width: 1rem" disabled name="dob-age" id="age_field" value=""> -->
            </div>

        <!-- </div> -->
   
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var dobInput = document.getElementById('datepicker');

                /* flatpickr splits the field in two: this original input
                 * keeps the real value (dateFormat, ISO Y-m-d, what actually
                 * gets submitted) and becomes hidden, while a second,
                 * visible "alt" input (altFormat, d-m-Y -- this app's usual
                 * display convention, see formatDate()/formatDateTime() in
                 * zeusfw core/kernel/utils.php) is what the user actually
                 * sees and types into. dobChange() reads e.value/e.classList/
                 * e.attributes['agefield'] off whatever element it's given,
                 * so pointing it at instance.altInput -- once agefield is
                 * copied onto it, since flatpickr creates that input fresh
                 * with none of the original's custom attributes -- needs no
                 * changes to dobChange() itself. */
                flatpickr(dobInput, {
                    dateFormat: 'Y-m-d',
                    altInput: true,
                    altFormat: 'd-m-Y',
                    allowInput: true,
                    onReady: function(selectedDates, dateStr, instance) {
                        instance.altInput.setAttribute('agefield', dobInput.getAttribute('agefield'));
                        dobChange(instance.altInput);
                    },
                    onValueUpdate: function(selectedDates, dateStr, instance) {
                        dobChange(instance.altInput);
                    }
                });
            });
        </script>

{# 
        <div class="input-div">
                <label for="patient-dob">Ημ/νια Γεννήσεως</label>
                <input type="date" name="patient-dob" id="" role="date-picker" loader="info-loader" value="{{$patient->getpdob() | date('Y-m-d') }}">
            <!-- <input type="text" name="patient-dob" id="datepicker" value="{{$patient->getpdob()}}"> -->
        </div>
 #}
        {# Gender: three radios rather than a menu, so choosing is one click.
           The last one ("not set", empty value) is a real choice -- a radio
           can't be un-picked, and the column is NULL until someone answers.
           Saved like every other field (autosave posts the whole form). #}
        {% $__g = $patient->getpgender(); %}
        <div class="input-div gender-field">
            <label id="patient-gender-label">Φύλο</label>
            <div class="gender-radios" role="radiogroup" aria-labelledby="patient-gender-label">
                <label class="gender-opt"><input type="radio" name="patient-gender" value="M" loader="info-loader" {{($__g === 'M') ? 'checked' : ''}}><span>Άνδρας</span></label>
                <label class="gender-opt"><input type="radio" name="patient-gender" value="F" loader="info-loader" {{($__g === 'F') ? 'checked' : ''}}><span>Γυναίκα</span></label>
                <label class="gender-opt gender-none"><input type="radio" name="patient-gender" value="" loader="info-loader" {{($__g !== 'M' && $__g !== 'F') ? 'checked' : ''}}><span title="Μη ορισμένο" aria-label="Μη ορισμένο">&mdash;</span></label>
            </div>
        </div>

        <div class="input-div">
            <label for="patient-amka">ΑΜΚΑ</label>
            {# 
                <input type="text" name="patient-amka" loader="info-loader" validator="amka" value="{{$patient->getpamka()}}" placeholder="ΑΜΚΑ ασθενούς">
            #}
            <input type="text" name="patient-amka" loader="info-loader" validator="amka" value="{{{$patient->getpamka()}}}" placeholder="ΑΜΚΑ ασθενούς">

            <div class="inline-icons">
                <i class='valid bx bx-check' style='color:#00ff00'  ></i>
                <i class='not-valid bx bx-error' style='color:#ff0000'  ></i>

                <i class="bx bx-copy" data-copy-text="{{{$patient->getpamka()}}}"></i>
            </div>

            <!-- <img class="valid" src="data:image/png;base64,"/> -->
            <!-- <img class="not-valid" src="data:image/png;base64,"/> -->
        </div>

        </div>

        <div class="pd-section pd-contact">
        <div class="pd-section-title"><i class="bx bx-phone"></i> Επικοινωνία</div>

        <div class="input-div">
            <label for="patient-telephone">Τηλέφωνο</label>
            <input type="text" name="patient-telephone" loader="info-loader" validator="telephone" value="{{{$patient->getptel()}}}" placeholder="τηλέφωνο ασθενούς">

            <div class="inline-icons">
                <i class='valid bx bx-check' style='color:#00ff00'  ></i>
                <i class='not-valid bx bx-error' style='color:#ff0000'  ></i>

                <a href="tel:{{{$patient->getptel()}}}"><i class="bx bx-phone-call"></i></a>
                <i class="bx bx-copy" data-copy-text="{{{$patient->getptel()}}}"></i>
            </div>
        </div>

        <div class="input-div">
            <label for="patient-email">Email</label>
            <input type="text" name="patient-email" loader="info-loader" validator="email" value="{{{$patient->getpemail()}}}" placeholder="email ασθενούς">

                <div class="inline-icons">
                    <i class='valid bx bx-check' style='color:#00ff00'  ></i>
                    <i class='not-valid bx bx-error' style='color:#ff0000'  ></i>

                    <i class="bx bx-copy" data-copy-text="{{{$patient->getpemail()}}}"></i>
                </div>
        </div>

        <div class="input-div">
            <label for="patient-address">Διεύθυνση</label>
            <input type="text" name="patient-address" loader="info-loader" id=""  value="{{{$patient->getpaddr()}}}" placeholder="διεύθυνση ασθενούς">
        </div>

        </div>

        <div class="pd-section pd-notes">
        <div class="pd-section-title"><i class="bx bx-note"></i> Σημειώσεις</div>

        <div class="input-div">
            <label for="patient-note">Σημειώσεις</label>
            <textarea name="patient-note" loader="info-loader" id="" rows="5" placeholder="σημειώσεις">{{{$patient->getpnote()}}}</textarea>
        </div>
        </div>
        </fieldset>

        <div class="buttons">
            {% if($can_edit_patient): %}
                <input type="submit" name="submit" value="Αποθήκευση">

                {% if($action == 'new'): %}
                    <input type="submit" name="submitedit" value="Αποθήκευση & Επεξεργασία">
                {% else: %}
                    <!-- Fields autosave as you type (loader.js), so this was
                         never a real "undo" -- it now just closes the panel. -->
                    <button type="button" class="btn-secondary" data-close-details>Κλείσιμο</button>
                {% endif %}
            {% else: %}
                <a href="{{rel_url('/patients')}}" class="btn-secondary">&larr; Πίσω στη λίστα</a>
            {% endif %}

            <button hidden type="button" loader="info-loader" onclick="field_update(this)">Update</button>
            <div id="info-loader" class="loader0"></div>
        </div>
    </form>
    </div>

    {% if($action != 'new'): %}
    <div class="patient-cols{{(isset($all_files) && count($all_files) > 0) ? ' has-side' : ''}}">
        <div class="patient-main">

            {% if($can_edit_appointment || (isset($appointments) && count($appointments) > 0)): %}
            <section class="patient-appts" aria-label="Ραντεβού και χειρουργεία">
                <div class="patient-appts-head">
                    <h4>Ραντεβού &amp; Χειρουργεία</h4>
                    {% if(isset($appointments) && count($appointments) > 0): %}<span class="file-count-badge">{{count($appointments)}}</span>{% endif %}

                    {% if($can_edit_appointment): %}
                    <div class="patient-appointments">
                        <a href="{{rel_url('/appointment/'.$id.'/newappointment')}}">
                            <div class="new-appointment">
                                Νέο Ραντεβού
                            </div>
                        </a>
                        <!-- Type is decided entirely by which of these two links was
                             clicked -- a separate route, not a ?type=operation query
                             string (the router matches on $_SERVER['QUERY_STRING']
                             itself, and .htaccess's [QSA] rewrite flag would append a
                             real query string onto that same value and break route
                             matching -- see patient_operation_new()'s own comment in
                             web/index.php). There's no dropdown anywhere in the
                             appointment/operation flow any more; once created, the
                             type is permanent. -->
                        <a href="{{rel_url('/appointment/'.$id.'/newoperation')}}">
                            <div class="new-appointment new-operation">
                                Νέο Χειρουργείο
                            </div>
                        </a>
                    </div>
                    {% endif %}
                </div>

                {% if(isset($appointments) && (count($appointments)>0)): %}
                <!-- One summary row per appointment/operation, newest first.
                     The full editable card (view_appointment.zetem) lives in
                     the row's panel and opens in place, so inline editing,
                     attachments and delete all work exactly as before; the
                     newest row starts open. The card keeps its #app-N anchor,
                     which the script below opens on a click or a URL hash. -->
                <ul class="patient-appointments-list">
                    {% foreach($appointments as $ap): %}
                    <li class="appt-row {{($ap['row']['is_operation']) ? 'is-operation' : 'is-visit'}}{{($ap['index'] == 0) ? ' is-open' : ''}}" data-index="{{$ap['index']}}">
                        <button type="button" class="appt-row-head" aria-expanded="{{($ap['index'] == 0) ? 'true' : 'false'}}" aria-controls="appt-panel-{{$ap['index']}}">
                            <span class="ar-date">{{$ap['row']['date'] | date('d-m-Y')}}</span>
                            <span class="ar-type"><i class="bx {{($ap['row']['is_operation']) ? 'bx-plus-medical' : 'bx-calendar-check'}}"></i> {{($ap['row']['is_operation']) ? 'Χειρουργείο' : 'Ραντεβού'}}</span>
                            <span class="ar-place">{% if($ap['row']['place']): %}<i class="bx bx-map-pin"></i> {{{$ap['row']['place']}}}{% endif %}</span>
                            <span class="ar-note">{{{$ap['row']['note']}}}</span>
                            <span class="ar-meta">{% if($ap['row']['file_count'] > 0): %}<span title="Συνημμένα αρχεία"><i class="bx bx-paperclip"></i> {{$ap['row']['file_count']}}</span>{% endif %}</span>
                            <i class="bx bx-chevron-right ar-chev"></i>
                        </button>
                        <div class="appt-row-panel" id="appt-panel-{{$ap['index']}}" {% if($ap['index'] != 0): %}hidden{% endif %}>{{$ap['markup']}}</div>
                    </li>
                    {% endforeach %}
                </ul>
                {% endif %}
            </section>
            {% endif %}

            {% if(isset($appointments) && (count($appointments)>0)): %}
        <!-- One combined edit-history log for the whole patient record --
             covers every appointment above, not a separate list per card
             (each appointment card used to carry its own; see
             view_appointment.zetem's own comment on why that moved here).
             Read-only regardless of $can_edit_appointment -- this is a
             log, not an editable control -- and shown to the same
             audience as the appointment cards above (appointment-edit AND
             appointment-view), since "see what changed" is exactly what
             appointment-view is meant to allow (web/rbac.php). See
             web/appointment_history.php's own docblock for the 5-minute
             session design (a session here means "one user's burst of
             saves on one appointment, each no more than 5 minutes after
             the last", not a login/browser session). Rendered as a
             timeline; collapsed until the heading is clicked. -->
        <div class="appointment-history-section" id="patient-history">
            <h5 class="appointment-history-heading" id="patient-history-heading">
                <i class='bx bx-chevron-right toggle-icon'></i>
                <span>Ιστορικό Αλλαγών</span>
                {% if(isset($patient_history) && count($patient_history) > 0): %}
                <span class="file-count-badge">{{count($patient_history)}}</span>
                {% endif %}
            </h5>

            <div class="appointment-history-body">
                {% if(!isset($patient_history) || count($patient_history) == 0): %}
                <p class="no-files">Δεν υπάρχουν καταγεγραμμένες αλλαγές</p>
                {% else: %}
                <ul class="appointment-history-list history-timeline">
                    {% foreach($patient_history as $h): %}
                    <li class="appointment-history-item{{(strpos($h['appointment_label'], 'Χειρουργείο') === 0) ? ' is-operation' : ''}}">
                        <span class="history-title"><span class="history-fields">{{implode(', ', $h['fields'])}}</span> &middot; <span class="history-appointment">{{{$h['appointment_label']}}}</span></span>
                        <span class="history-meta">
                            <span class="history-user">{{{$h['user']}}}</span> &middot;
                            <span class="history-time">{% if($h['single_moment']): %}{{$h['started_at']}}{% else: %}{{$h['started_at']}} &ndash; {{$h['ended_at']}}{% endif %}</span> &middot;
                            <span class="history-count">({{$h['change_count']}} {{($h['change_count'] == 1) ? 'αλλαγή' : 'αλλαγές'}})</span>
                        </span>
                    </li>
                    {% endforeach %}
                </ul>
                {% endif %}
            </div>
        </div>
            {% endif %}

    {% if(isset($appointment_summary) && (count($appointment_summary)>0)): %}
        <!-- Compact read-only view for a viewer without appointment-edit
             (e.g. the secretary role) -- just the date and location of
             each appointment/operation, no notes/save/delete/attachment
             controls (see patient_edit() in web/index.php, which builds
             this instead of the full editable cards above whenever
             $canEditAppointment is false). -->
        <div class="appointment-summary-readonly">
            <h4>Ραντεβού</h4>
            <div class="settings-table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Ημερομηνία</th>
                            <th>Τοποθεσία</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% foreach($appointment_summary as $as): %}
                        <tr>
                            <td>{{$as['date'] | date('d-m-Y H:i')}}</td>
                            <td>{{{$as['location'] ?: '—'}}}</td>
                        </tr>
                        {% endforeach %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

        </div>

        {% if(isset($all_files) && count($all_files) > 0): %}
        <aside class="patient-side" aria-label="Έγγραφα ασθενή">
            <div class="side-card">
                <div class="side-card-head">
                    <h4>Έγγραφα</h4><span class="file-count-badge">{{count($all_files)}}</span>
                </div>
                <ul class="side-files">
                    {% foreach($all_files as $f): %}
                    <li>
                        <span class="sf-ic{{($f['is_image']) ? ' is-image' : ''}}"><i class="bx {{($f['is_image']) ? 'bx-image' : 'bxs-file-pdf'}}"></i></span>
                        <span class="sf-txt">
                            <a class="sf-name" href="{{$f['url']}}" target="_blank" rel="noopener">{{{$f['name']}}}</a>
                            <a class="sf-sub" href="{{$f['appointment_anchor']}}">{{{$f['appointment_label']}}} &middot; {{{$f['size']}}}</a>
                        </span>
                    </li>
                    {% endforeach %}
                </ul>
            </div>
        </aside>
        {% endif %}
    </div>

    {% if(isset($has_financials) && $has_financials): %}
        <!-- Read-only APYweb financial-info block -- see
             web/apyweb_client.php / api_financial.php. No forms, no edit
             controls, no outbound links: APYweb has no per-record
             deep-link URL scheme, this is purely informational. -->
        <div class="financial-info">
            <h4>Οικονομικά Στοιχεία</h4>

            {% if(count($financials['invoices'])>0): %}
            <h5>Παραστατικά</h5>
            <div class="settings-table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Ημερομηνία</th>
                            <th>ΜΑΡΚ</th>
                            <th>Ποσό</th>
                            <th>Πληρωτέο</th>
                            <th>Τρόπος Πληρωμής</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% foreach($financials['invoices'] as $inv): %}
                        <tr>
                            <td>{{$inv['doc_date'] | date('d-m-Y')}}</td>
                            <td>{{{$inv['mark']}}}</td>
                            <td>{{{number_format((float)$inv['gross_amount'], 2, ',', '.')}}} &euro;</td>
                            <td>{{{number_format((float)$inv['net_payable'], 2, ',', '.')}}} &euro;</td>
                            <td>{{{$inv['payment_method'] ?? '—'}}}</td>
                        </tr>
                        {% endforeach %}
                    </tbody>
                </table>
            </div>
            {% endif %}

            {% if(count($financials['operations'])>0): %}
            <h5>Χειρουργεία / Επεμβάσεις</h5>
            <div class="settings-table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Ημερομηνία</th>
                            <th>Επέμβαση</th>
                            <th>Κλινική</th>
                            <th>Ποσό</th>
                            <th>Ασφάλεια</th>
                            <th>Ασθενής</th>
                            <th>Κατάσταση</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% foreach($financials['operations'] as $op): %}
                        <tr>
                            <td>{{$op['op_date'] | date('d-m-Y')}}</td>
                            <td>{{{$op['operation'] ?? '—'}}}</td>
                            <td>{{{$op['clinic'] ?? '—'}}}</td>
                            <td>{{{number_format((float)$op['amount'], 2, ',', '.')}}} &euro;</td>
                            <td>{{{$op['insurance_amount'] !== null ? number_format((float)$op['insurance_amount'], 2, ',', '.') . ' €' : '—'}}}</td>
                            <td>{{{$op['patient_amount'] !== null ? number_format((float)$op['patient_amount'], 2, ',', '.') . ' €' : '—'}}}</td>
                            <td>{{$op['paid'] ? 'Πληρώθηκε' : 'Εκκρεμεί'}}</td>
                        </tr>
                        {% endforeach %}
                    </tbody>
                </table>
            </div>
            {% endif %}

            {% if(count($financials['fee_reports'])>0): %}
            <h5>Αμοιβές Κλινικής</h5>
            <div class="settings-table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Ημερομηνία</th>
                            <th>Ιατρός</th>
                            <th>Σύμβαση</th>
                            <th>Ασφάλεια</th>
                            <th>Ασθενής</th>
                            <th>ΑΠΥ</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% foreach($financials['fee_reports'] as $fr): %}
                        <tr>
                            <td>{{$fr['fee_date'] | date('d-m-Y')}}</td>
                            <td>{{{$fr['doctor_name']}}}</td>
                            <td>{{{number_format((float)$fr['amount_contract'], 2, ',', '.')}}} &euro;</td>
                            <td>{{{number_format((float)$fr['amount_insurance'], 2, ',', '.')}}} &euro;</td>
                            <td>{{{number_format((float)$fr['amount_patient'], 2, ',', '.')}}} &euro;</td>
                            <td>{{{$fr['apy_number'] ?? '—'}}}</td>
                        </tr>
                        {% endforeach %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>
    {% endif %}

    {% if($can_delete_patient): %}
    <!-- Patient deletion sits alone at the bottom, away from the creation
         buttons next to the appointments, so it is hard to hit by mistake. -->
    <div class="patient-danger">
        <form class="inline-delete-form" method="post" action="{{rel_url('/patient/'.$id.'/delete')}}" confirmation>
            {{ csrf_field() }}
            <button type="submit" class="btn-danger">
                <i class="bx bx-trash"></i> Διαγραφή Ασθενή
            </button>
        </form>
    </div>
    {% endif %}
    {% endif %}

    {% if($action != 'new'): %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            /* ---- personal details panel (open/close) ---- */
            var toggle = document.getElementById('patient-details-toggle');
            var panel = document.getElementById('patient-details');
            function setDetails(open) {
                if (!toggle || !panel) return;
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                toggle.querySelector('span').textContent = open ? toggle.dataset.labelOpen : toggle.dataset.labelClosed;
                panel.hidden = !open;
            }
            if (toggle && panel) {
                toggle.addEventListener('click', function() {
                    setDetails(toggle.getAttribute('aria-expanded') !== 'true');
                });
                panel.querySelectorAll('[data-close-details]').forEach(function(b) {
                    b.addEventListener('click', function() { setDetails(false); toggle.focus(); });
                });
            }

            /* ---- appointment rows: open/close the card in place ---- */
            function setRow(row, open) {
                var head = row.querySelector('.appt-row-head');
                var body = row.querySelector('.appt-row-panel');
                row.classList.toggle('is-open', open);
                head.setAttribute('aria-expanded', open ? 'true' : 'false');
                body.hidden = !open;
            }
            document.querySelectorAll('.appt-row').forEach(function(row) {
                row.querySelector('.appt-row-head').addEventListener('click', function() {
                    setRow(row, !row.classList.contains('is-open'));
                });
            });
            /* A link to an appointment card (#app-N: the Έγγραφα list, or a
               URL hash) has to open that row first -- a browser can't
               scroll to something inside a hidden panel. */
            function openFromHash(hash) {
                if (!/^#app-\d+$/.test(hash)) return false;
                var card = document.getElementById(hash.slice(1));
                var row = card && card.closest('.appt-row');
                if (!row) return false;
                setRow(row, true);
                card.scrollIntoView({ block: 'start' });
                return true;
            }
            document.addEventListener('click', function(e) {
                var a = e.target.closest('a[href^="#app-"]');
                if (a && openFromHash(a.getAttribute('href'))) e.preventDefault();
            });
            if (location.hash) openFromHash(location.hash);

            /* ---- identity header follows the form while it is open ---- */
            function field(name) { return document.querySelector('#patient-details [name="' + name + '"]'); }
            function show(id, value) {
                var el = document.getElementById(id);
                var wrap = document.getElementById(id + '-wrap');
                if (el) el.textContent = value;
                if (wrap) wrap.hidden = value.trim() === '';
                return el;
            }
            function initials(name) {
                return name.trim().split(/\s+/).filter(Boolean).slice(0, 2).map(function(w) {
                    return w.charAt(0).toLocaleUpperCase('el');
                }).join('');
            }
            [['patient-name', 'pi-name'], ['patient-amka', 'pi-amka'], ['patient-telephone', 'pi-tel'],
             ['patient-email', 'pi-email'], ['patient-address', 'pi-addr'], ['patient-note', 'pi-note']].forEach(function(m) {
                var input = field(m[0]);
                if (!input) return;
                input.addEventListener('input', function() {
                    var v = input.value;
                    var el = show(m[1], v);
                    if (m[1] === 'pi-name') {
                        var av = document.querySelector('.pi-avatar');
                        if (av) av.textContent = initials(v);
                    }
                    if (m[1] === 'pi-tel' && el) el.setAttribute('href', 'tel:' + v);
                    if (m[1] === 'pi-email' && el) el.setAttribute('href', 'mailto:' + v);
                    if (m[1] === 'pi-amka') {
                        var c = document.getElementById('pi-amka-copy');
                        if (c) c.setAttribute('data-copy-text', v);
                    }
                });
            });
            document.querySelectorAll('#patient-details input[name="patient-gender"]').forEach(function(radio) {
                radio.addEventListener('change', function() {
                    var g = document.getElementById('pi-gender');
                    if (!g || !radio.checked) return;
                    g.textContent = radio.value === 'F' ? 'Γυναίκα' : 'Άνδρας';
                    g.hidden = radio.value !== 'M' && radio.value !== 'F';
                });
            });
            var dob = document.getElementById('datepicker');
            if (dob) {
                dob.addEventListener('change', function() {
                    setTimeout(function() {
                        var iso = dob.value.split('-');
                        var dobEl = document.getElementById('pi-dob');
                        if (dobEl) { dobEl.textContent = iso.length === 3 ? iso[2] + '-' + iso[1] + '-' + iso[0] : ''; dobEl.hidden = iso.length !== 3; }
                        var ageSrc = document.getElementById('age_field');
                        var ageEl = document.getElementById('pi-age');
                        if (ageSrc && ageEl) { ageEl.textContent = ageSrc.textContent.trim(); ageEl.hidden = ageEl.textContent === ''; }
                    }, 0);
                });
            }

            /* ---- change history: click the heading to expand ---- */
            var historyHeading = document.getElementById('patient-history-heading');
            var historySection = document.getElementById('patient-history');
            if (historyHeading && historySection) {
                historyHeading.addEventListener('click', function() {
                    historySection.classList.toggle('is-expanded');
                });
            }
        });
    </script>
    {% endif %}
</div>
