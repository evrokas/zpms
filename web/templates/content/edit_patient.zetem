
{% attach_library('loader-library'); %}
{% attach_library('textarea-expandable-library'); %}

<div class="edit-patient">
    <form action="{{$action}}" method="post">

        <div class="card mb-lg">
            <div class="card-header">
                <h3 class="card-title">{{t("Personal Information")}}</h3>
            </div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="form-group">
                        <div class="input-div">
                            <label for="patient-name">{{t("Patient Name")}}</label>
                            <input type="text" name="patient-name" loader="info-loader" id="" value="{{$patient->getpname()}}" placeholder="{{t('patient name')}}">
                            <div class="inline-icons">
                                <i class="bx bx-copy" data-copy-text="{{$patient->getpname()}}" onclick0="copyStr('{{$patient->getpname()}}')"></i>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-div">
                            <label for="patient-dob">{{t("Date of Birth")}}</label>
                            <input type="text" name="patient-dob" id="datepicker" loader="info-loader" value="{{$patient->getpdob()| date('d-m-Y')}}" onkeyup="dobChange(this)" agefield="age_field">
                            <div class="inline-icons">
                                <i class='not-valid bx bx-error' style='color:#ff0000'></i>
                                <span for="dob-age" id="age_field" style="width: max-content;" disabled>{{t("Age")}}</span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-div">
                            <label for="patient-amka">{{t("AMKA")}}</label>
                            <input type="text" name="patient-amka" loader="info-loader" validator="amka" value="{{$patient->getpamka()}}" placeholder="{{t('AMKA')}}">
                            <div class="inline-icons">
                                <i class='valid bx bx-check' style='color:#00ff00'></i>
                                <i class='not-valid bx bx-error' style='color:#ff0000'></i>
                                <i class="bx bx-copy" data-copy-text="{{$patient->getpamka()}}" onclick0="copyStr0('{{$patient->getpamka()}}')"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-lg">
            <div class="card-header">
                <h3 class="card-title">{{t("Contact Information")}}</h3>
            </div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="form-group">
                        <div class="input-div">
                            <label for="patient-telephone">{{t("Telephone")}}</label>
                            <input type="text" name="patient-telephone" loader="info-loader" validator="telephone" value="{{$patient->getptel()}}" placeholder="{{t('telephone')}}">
                            <div class="inline-icons">
                                <i class='valid bx bx-check' style='color:#00ff00'></i>
                                <i class='not-valid bx bx-error' style='color:#ff0000'></i>
                                <a href="tel:{{$patient->getptel()}}"><i class="bx bx-phone-call"></i></a>
                                <i class="bx bx-copy" data-copy-text="{{$patient->getptel()}}" onclick="copyStr0('{{$patient->getptel()}}')"></i>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-div">
                            <label for="patient-email">{{t("Email")}}</label>
                            <input type="text" name="patient-email" loader="info-loader" validator="email" value="{{$patient->getpemail()}}" placeholder="{{t('email')}}">
                            <div class="inline-icons">
                                <i class='valid bx bx-check' style='color:#00ff00'></i>
                                <i class='not-valid bx bx-error' style='color:#ff0000'></i>
                                <i class="bx bx-copy" onclick="copyStr('{{$patient->getpemail()}}')"></i>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-div">
                            <label for="patient-address">{{t("Address")}}</label>
                            <input type="text" name="patient-address" loader="info-loader" id="" value="{{$patient->getpaddr()}}" placeholder="{{t('address')}}">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-lg">
            <div class="card-header">
                <h3 class="card-title">{{t("Notes")}}</h3>
            </div>
            <div class="card-body">
                <div class="input-div input-notes">
                    <label for="patient-note">{{t("Notes")}}</label>
                    <textarea name="patient-note" loader="info-loader" autoexpand id="" rows="5" placeholder="{{t('notes')}}">{{$patient->getpnote()}}</textarea>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <input type="submit" name="submit" class="btn btn-primary" value="{{t('Save')}}">
            {% if($action == 'new'): %}
                <input type="submit" name="submitedit" class="btn btn-success" value="{{t('Save & Edit')}}">
            {% else: %}
                <input type="submit" name="delete" class="btn btn-danger" value="{{t('Cancel')}}">
            {% endif %}
            <button hidden type="button" loader="info-loader" onclick="field_update(this)">Update</button>
            <div id="info-loader" class="loader0"></div>
        </div>
    </form>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            dobChange(document.getElementById('datepicker'));
        });
    </script>

    {% if($action != 'new'): %}
        <div class="card mb-lg mt-lg">
            <div class="card-header">
                <h3 class="card-title">{{t("Appointments")}}</h3>
                <a href="{{rel_url('/appointment/'.$id.'/newappointment')}}" class="btn btn-sm btn-primary"><i class="bx bx-plus"></i> {{t("New Appointment")}}</a>
            </div>
            <div class="card-body">
    {% endif %}

    {% if(isset($appointments) && (count($appointments)>0)): %}
                <div class="appointment-dates mb-lg">
                    {% foreach($appdates as $ad): %}
                        <li>
                            <a href="#app-{{$ad['index']}}">
                                Date {{$ad['index']}}: {{$ad['date'] | date('d-m-Y')}}
                            </a>
                        </li>
                    {% endforeach %}
                </div>

                <ul class="patient-appointments-list">
                    {% foreach($appointments as $ap): %}
                        <li data-index="{{$ap['index']}}">{{$ap['markup']}}</li>
                    {% endforeach %}
                </ul>
    {% endif %}

    {% if($action != 'new'): %}
            </div>
        </div>
    {% endif %}
</div>
