{% attach_library('boxicons') %}
{% attach_library('loader-library') %}
{% attach_library('quill-library') %}
{% attach_library('profile-notes-library') %}

<div class="dashboard">
    <div class="dashboard-welcome">
        <h2>{{{t('Welcome')}}}{% if($display_name): %}, {{{$display_name}}}{% endif %}</h2>
        {% if($location): %}
            <p class="dashboard-location"><i class="bx bx-map"></i> {{{$location}}}</p>
        {% endif %}
    </div>

    <div class="dashboard-grid">
        {% if($can_view_patients): %}
        <a class="dashboard-card hover-lift" href="{{rel_url('/patients')}}">
            <i class="bx bx-group"></i>
            <span class="dashboard-card-title">{{{t('Patients')}}}</span>
            <span class="dashboard-card-desc">{{{t('List and manage patients')}}}</span>
        </a>
        {% endif %}

        {% if($can_create_patients): %}
        <a class="dashboard-card hover-lift" href="{{rel_url('/patient/new')}}">
            <i class="bx bx-user-plus"></i>
            <span class="dashboard-card-title">{{{t('New patient')}}}</span>
            <span class="dashboard-card-desc">{{{t('Register a new patient')}}}</span>
        </a>
        {% endif %}

        <a class="dashboard-card hover-lift" href="{{rel_url('/apps/genqr')}}">
            <i class="bx bx-qr"></i>
            <span class="dashboard-card-title">{{{t('Create QR')}}}</span>
            <span class="dashboard-card-desc">{{{t('Create a QR code')}}}</span>
        </a>

        {% if($can_manage_appointments): %}
        <a class="dashboard-card hover-lift" href="{{rel_url('/consultation/pending')}}">
            <i class="bx bx-calendar"></i>
            <span class="dashboard-card-title">{{{t('Appointments')}}}</span>
            <span class="dashboard-card-desc">{{{t('Pending and previous appointments')}}}</span>
        </a>
        {% endif %}
    </div>

        {# Personal notes (Quill editor). Private to this account: the save
           handler (userprofile module, POST /profile action=save_notes) only ever
           reads/writes the signed-in user's own row. Autosaves like the
           patient fields -- loader.js waits 1s after the last change, each
           keystroke restarts the wait; profile-notes.js copies the editor's HTML
           into the hidden "notes" field and hands the form to loader.js. The
           HTML below was cleaned by zpms_sanitize_notes_html() when it was
           saved, so it is printed as-is. #}
        <div class="user-notes" style="--notes-label-normal: '{{{t('Normal text')}}}'; --notes-label-h2: '{{{t('Heading')}}}'; --notes-label-h3: '{{{t('Subheading')}}}';">
            <div class="user-notes-head">
                <h2>{{{t('My notes')}}}</h2>
                <div id="notes-loader" class="loader0"></div>
            </div>
            <p class="field-hint">{{{t('Visible only to you. Saved automatically as you type.')}}}</p>
            <form action="{{rel_url('/profile')}}" method="post" id="profile-notes-form">
                {{ csrf_field() }}
                <input type="hidden" name="action" value="save_notes">
                <input type="hidden" name="notes" id="profile-notes-value" value="{{{$notes_html}}}">
                <div id="profile-notes-editor" class="user-notes-editor" data-placeholder="{{{t('Write your notes here...')}}}">{{ $notes_html }}</div>
                <button hidden type="button" loader="notes-loader">{{{t('Update')}}}</button>
            </form>
        </div>
</div>
