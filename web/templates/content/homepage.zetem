{% attach_library('boxicons') %}

<div class="dashboard">
    <div class="dashboard-welcome">
        <h2>Καλώς ήρθατε{% if($display_name): %}, {{{$display_name}}}{% endif %}</h2>
        {% if($location): %}
            <p class="dashboard-location"><i class="bx bx-map"></i> {{{$location}}}</p>
        {% endif %}
    </div>

    <div class="dashboard-grid">
        {% if($can_view_patients): %}
        <a class="dashboard-card hover-lift" href="{{rel_url('/patients')}}">
            <i class="bx bx-group"></i>
            <span class="dashboard-card-title">Ασθενείς</span>
            <span class="dashboard-card-desc">Λίστα και διαχείριση ασθενών</span>
        </a>
        {% endif %}

        {% if($can_create_patients): %}
        <a class="dashboard-card hover-lift" href="{{rel_url('/patient/new')}}">
            <i class="bx bx-user-plus"></i>
            <span class="dashboard-card-title">Νέος Ασθενής</span>
            <span class="dashboard-card-desc">Καταχώρηση νέου ασθενή</span>
        </a>
        {% endif %}

        <a class="dashboard-card hover-lift" href="{{rel_url('/apps/genqr')}}">
            <i class="bx bx-qr"></i>
            <span class="dashboard-card-title">Δημιουργία QR</span>
            <span class="dashboard-card-desc">Δημιουργία κωδικού QR</span>
        </a>
    </div>
</div>
