{% attach_library('loader-library'); %}
{% attach_library('flatpickr-library'); %}
{% attach_library('booking-picker'); %}

<div class="edit-patient">
    {# Visually hidden: the breadcrumb above already names this page. Kept as the
       page heading for screen readers. #}
    <h2 class="sr-only">{{{t('Edit pending appointment')}}}</h2>

    <p class="muted page-back">
        <a href="{{rel_url('/consultation/pending')}}">&larr; {{{t('Back to Pending Appointments')}}}</a>
    </p>

    <form action="{{rel_url('/consultation/pending/'.$pending->getid().'/edit')}}" method="post">
        {{ csrf_field() }}

        <div class="input-div">
            <label for="patient-name">{{{t('Patient name')}}}</label>
            <input type="text" name="patient-name" id="" value="{{{$pending->getpatient_name()}}}" required>
        </div>

        <div class="input-div">
            <label for="patient-telephone">{{{t('Telephone')}}}</label>
            <input type="text" name="patient-telephone" id="" value="{{{$pending->getpatient_phone()}}}">
        </div>

        <div class="input-div">
            <label for="patient-amka">{{{t('AMKA')}}}</label>
            <input type="text" name="patient-amka" id="" value="{{{$pending->getpatient_amka()}}}">
        </div>

        <div class="input-div">
            <label for="patient-email">{{{t('Email')}}}</label>
            <input type="text" name="patient-email" id="" value="{{{$pending->getpatient_email()}}}">
        </div>

        {{ $booking_picker }}

        <div class="input-div">
            <label for="appointment-user">{{{t('Doctor')}}}</label>
            <select name="appointment-user" id="" required>
                <option value="">{{{t('-- Select a doctor --')}}}</option>
                {% foreach($doctors as $doctor): %}
                <option value="{{{$doctor['id']}}}" {{($doctor['id'] == $pending->getassigned_user_id())?'selected':''}}>{{{$doctor['name']}}}</option>
                {% endforeach %}
            </select>
        </div>

        <div class="input-div input-notes">
            <label for="appointment-notes">{{{t('Notes')}}}</label>
            <textarea name="appointment-notes" id="" rows="4">{{{$pending->getnotes()}}}</textarea>
        </div>

        <div class="buttons">
            <input type="submit" name="submit" value="{{{t('Save')}}}">
        </div>
    </form>
</div>
