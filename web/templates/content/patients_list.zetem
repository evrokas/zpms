{% attach_library('boxicons') %}

<div class="patients-header">
    <h2 class="page-title">{{t("Patients")}}</h2>
    <a class="btn-add-patient" href="{{rel_url('/patient/new')}}">
        <i class="bx bx-plus"></i>{{t("Add new patient")}}
    </a>
</div>

<div class="search">
    <form action="{{rel_url('patients/search')}}" method="post">
        {{ csrf_field() }}
        <div class="input-div">
            <i class="bx bx-search search-icon"></i>
            <input type="text" class="select2 focus-primary" name="search-term" id="" autocomplete="off" aria-label="{{t('Search')}}" placeholder="Αναζήτηση με όνομα, ΑΜΚΑ ή τηλέφωνο&hellip;" value="{% if(isset($search_term))echo htmlspecialchars($search_term, ENT_QUOTES, 'UTF-8'); %}">
        </div>
        <div class="select-container">
            <ul class="select-box" id="select-box">
                <!-- <li>Opt 1</li> -->
                <!-- <li>Opt 2</li> -->
                <!-- <li>Opt 3</li> -->
            </ul>
        </div>
    </form>
</div>
<div class="patients-list">
    {% if(count($pat_list) == 0): %}
        <div class="patients-empty">
            <i class="bx bx-user-plus"></i>
            <p>{{t("No patients found.")}}</p>
        </div>
    {% else: %}
    <table>
        <thead>
            <!-- <th>#</th> -->
            <th>{{t("Name")}}
                <div class="sorting-arrows">
                    <i class="bx bx-chevron-down"></i>
                    <i class="bx bx-chevron-up"></i>
                </div>
            </th>
            <th>{{t("AMKA")}}

            </th>
            <th>{{t("Last App")}}
                <div class="sorting-arrows">
                    <i class="bx bx-chevron-down"></i>
                    <i class="bx bx-chevron-up"></i>
                </div>

            </th>
            <th>{{t("Ενέργειες")}}</th>
        </thead>
        {% $loop=0; %}
        <tbody>
            {% foreach($pat_list as $pat): %}
            <tr>
                {% $loop++ %}
                <!-- <td>{{$loop}}</td> -->
                <td data-column="name">
                    <a href="{{rel_url('/patient/'.$pat['id'].'/edit')}}">{{{$pat['pname']}}}</a>
                    {% if(strlen($pat['pname'])>0): %}
                        <i class='bx bx-copy' data-copy-text="{{{$pat['pname']}}}"></i>
                    {% endif %}
                </td>

                <td data-column="amka">
                    {{{$pat['pamka']}}}
                    {% if(strlen($pat['pamka'])>0): %}
                        <i class='bx bx-copy' data-copy-text="{{{$pat['pamka']}}}"></i>
                    {% endif %}
                </td>

                <td data-column="lastapp">
                    {% if($pat['lastapp']): %}
                        {% echo explode(' ', $pat['lastapp'])[0]; %}
                    {% else: %}
                        -
                    {% endif %}
                </td>
                <td class="actions" data-column="actions">
                    <form class="inline-delete-form" method="post" action="{{rel_url('/patient/'.$pat['id'].'/delete')}}" confirmation>
                        {{ csrf_field() }}
                        <button type="submit" class="icon-btn icon-btn-danger" title="{{t('Delete')}}"><i class="bx bx-trash"></i></button>
                    </form>
                </td>
            </tr>
            {% endforeach %}
        </tbody>
    </table>
    {% endif %}
</div>

