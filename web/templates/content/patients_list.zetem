{% attach_library('boxicons') %}
{% attach_library('patients-list') %}
{#
  patients_list.zetem -- the patient list (/patients).

  Rows, state and links all come from patients_list() in web/index.php:
  $rows (one array per patient on this page), $state (q, area, sort, dir,
  per_page, page), $total/$from/$to/$pages, $page_links/$prev_url/$next_url,
  $sort_urls, $areas, $summary. The search box, area menu and rows-per-page
  menu all belong to one plain GET form (#patients-form), so the list works
  without JavaScript; the script at the bottom only submits it when a menu
  changes, remembers compact mode, and makes a whole row clickable.
#}

<div class="patients-header">
    <div class="patients-title">
        {# Visually hidden: the breadcrumb above already says "Ασθενείς › Λίστα
           ασθενών"; kept as the page's heading for screen readers. #}
        <h2 class="page-title sr-only">{{t("Patients")}}</h2>
        <ul class="patients-summary" aria-label="{{{t('Summary')}}}">
            <li>{{t('@count patients', ['count' => '<b>' . (int)$summary['total'] . '</b>'])}}</li>
            <li>{{t('@count new in the last 30 days', ['count' => '<b>' . (int)$summary['new'] . '</b>'])}}</li>
            <li>{{t('@count appointments today', ['count' => '<b>' . (int)$summary['today'] . '</b>'])}}</li>
        </ul>
    </div>
    {% if($can_create_patient): %}
    <a class="btn-add-patient" href="{{rel_url('/patient/new')}}">
        <i class="bx bx-plus"></i>{{t("Add new patient")}}
    </a>
    {% endif %}
</div>

<form class="patients-toolbar" id="patients-form" method="get" action="{{rel_url('/patients')}}" role="search">
    <div class="search">
        <div class="input-div">
            <i class="bx bx-search search-icon"></i>
            <input type="text" class="select2 focus-primary" name="q" id="patients-q" autocomplete="off" aria-label="{{t('Search')}}" placeholder="{{{t('Search by name, AMKA or telephone...')}}}" value="{{{$state['q']}}}">
        </div>
        <div class="select-container">
            <ul class="select-box" id="select-box"></ul>
        </div>
    </div>

    {% if(count($areas) > 0): %}
    <label class="pt-select">
        <select name="area" aria-label="{{{t('Area of the last appointment')}}}" data-autosubmit>
            <option value="">{{{t('All areas')}}}</option>
            {% foreach($areas as $area): %}
            <option value="{{{$area['value']}}}" {{($state['area'] === $area['value']) ? 'selected' : ''}}>{{{$area['label']}}}</option>
            {% endforeach %}
        </select>
    </label>
    {% endif %}

    <span class="pt-density" role="group" aria-label="{{{t('Display density')}}}">
        <button type="button" id="density-comfy" aria-pressed="true" title="{{{t('Comfortable view')}}}" aria-label="{{{t('Comfortable view')}}}"><i class="bx bx-list-ul"></i></button>
        <button type="button" id="density-compact" aria-pressed="false" title="{{{t('Compact view')}}}" aria-label="{{{t('Compact view')}}}"><i class="bx bx-menu"></i></button>
    </span>

    <input type="hidden" name="sort" value="{{{$state['sort']}}}">
    <input type="hidden" name="dir" value="{{{$state['dir']}}}">
    <noscript><button type="submit" class="pt-apply">{{{t('Apply')}}}</button></noscript>
</form>

<div class="patient-table" id="patient-table">
    {% if(count($rows) == 0): %}
        <div class="patients-empty">
            <i class="bx bx-user-plus"></i>
            <p>{{($searching) ? t('No patient matches your search.') : t("No patients found.")}}</p>
            {% if($searching): %}<p><a href="{{rel_url('/patients')}}">{{{t('Show all patients')}}}</a></p>{% endif %}
        </div>
    {% else: %}
    <div class="pt-scroll">
    <table>
        <thead>
            <tr>
                <th aria-sort="{{($state['sort'] === 'name') ? (($state['dir'] === 'asc') ? 'ascending' : 'descending') : 'none'}}">
                    <a class="th-sort{{($state['sort'] === 'name') ? ' is-active ' . $state['dir'] : ''}}" href="{{{$sort_urls['name']}}}">{{{t('Patient')}}} <span class="th-arrows"><i class="bx bx-chevron-up"></i><i class="bx bx-chevron-down"></i></span></a>
                </th>
                <th>{{{t('Contact')}}}</th>
                <th aria-sort="{{($state['sort'] === 'last') ? (($state['dir'] === 'asc') ? 'ascending' : 'descending') : 'none'}}">
                    <a class="th-sort{{($state['sort'] === 'last') ? ' is-active ' . $state['dir'] : ''}}" href="{{{$sort_urls['last']}}}">{{{t('Last appointment')}}} <span class="th-arrows"><i class="bx bx-chevron-up"></i><i class="bx bx-chevron-down"></i></span></a>
                </th>
                <th class="pt-actions-head" aria-hidden="true"></th>
            </tr>
        </thead>
        <tbody>
            {% foreach($rows as $r): %}
            <tr data-href="{{$r['url']}}">
                <td class="pt-patient">
                    <div class="pt-who">
                        <span class="pt-avatar tone-{{$r['tone']}}" aria-hidden="true">{{{$r['initials']}}}</span>
                        <div class="pt-id">
                            <a class="pt-name" href="{{$r['url']}}">{{{$r['name']}}}</a>
                            <div class="pt-sub">
                                {% if($r['age'] !== null): %}<span class="pt-age">{{t('@age years old', ['age' => (int)$r['age']])}}</span>{% endif %}
                                {% if($r['amka'] !== ''): %}<span>{{{t('AMKA')}}} {{{$r['amka']}}} <i class="bx bx-copy" title="{{{t('Copy AMKA')}}}" data-copy-text="{{{$r['amka']}}}"></i></span>{% endif %}
                            </div>
                        </div>
                    </div>
                </td>
                <td class="pt-contact">
                    {% if($r['tel'] !== ''): %}<a href="tel:{{{$r['tel']}}}">{{{$r['tel']}}}</a>{% endif %}
                    {% if($r['email'] !== ''): %}<span class="pt-email">{{{$r['email']}}}</span>{% endif %}
                    {% if($r['tel'] === '' && $r['email'] === ''): %}<span class="pt-none">&mdash;</span>{% endif %}
                </td>
                <td class="pt-last">
                    {% if($r['last']): %}
                    <span class="pt-date">{{$r['last']['date']}}</span>
                    <span class="pt-meta">
                        <span class="pt-chip{{($r['last']['is_operation']) ? ' is-operation' : ''}}">{{($r['last']['is_operation']) ? t('Operation') : t('Appointment')}}</span>
                        {% if($r['last']['upcoming']): %}<span class="pt-chip is-upcoming">{{{t('Upcoming')}}}</span>{% endif %}
                        {% if($r['last']['place'] !== ''): %}<span class="pt-place">{{{$r['last']['place']}}}</span>{% endif %}
                    </span>
                    {% else: %}
                    <span class="pt-none">&mdash;</span>
                    {% endif %}
                </td>
                <td class="pt-actions">
                    {% if($can_edit_appointment): %}
                    <a class="pt-icon" href="{{rel_url('/appointment/' . $r['id'] . '/newappointment')}}" title="{{{t('New appointment')}}}" aria-label="{{{t('New appointment for @name', ['name' => $r['name']])}}}"><i class="bx bx-calendar-plus"></i></a>
                    {% endif %}
                    <a class="pt-icon" href="{{$r['url']}}" title="{{{t('Open record')}}}" aria-label="{{{t('Open record of @name', ['name' => $r['name']])}}}"><i class="bx bx-chevron-right"></i></a>
                </td>
            </tr>
            {% endforeach %}
        </tbody>
    </table>
    </div>
    {% endif %}

    <div class="pt-pager">
        <span class="pt-count">{{{($total > 0) ? t('Showing @start-@end of @total patients', ['start' => $from, 'end' => $to, 'total' => $total]) : t('@count patients', ['count' => 0])}}}</span>
        <div class="pt-pager-right">
            <label class="pt-perpage">{{{t('Rows per page')}}}
                <select name="per_page" form="patients-form" aria-label="{{{t('Rows per page')}}}" data-autosubmit>
                    {% foreach($per_page_choices as $n): %}
                    <option value="{{$n}}" {{($state['per_page'] === $n) ? 'selected' : ''}}>{{($n === 'all') ? t('All') : $n}}</option>
                    {% endforeach %}
                </select>
            </label>
            {% if(count($page_links) > 0): %}
            <nav class="pt-pages" aria-label="{{{t('Pages')}}}">
                {% if($prev_url): %}<a href="{{{$prev_url}}}" aria-label="{{{t('Previous page')}}}">&lsaquo;</a>{% else: %}<span class="is-disabled" aria-hidden="true">&lsaquo;</span>{% endif %}
                {% foreach($page_links as $pl): %}
                    {% if(isset($pl['gap'])): %}<span class="pt-gap">&hellip;</span>
                    {% elseif($pl['current']): %}<span class="is-current" aria-current="page">{{$pl['n']}}</span>
                    {% else: %}<a href="{{{$pl['url']}}}">{{$pl['n']}}</a>{% endif %}
                {% endforeach %}
                {% if($next_url): %}<a href="{{{$next_url}}}" aria-label="{{{t('Next page')}}}">&rsaquo;</a>{% else: %}<span class="is-disabled" aria-hidden="true">&rsaquo;</span>{% endif %}
            </nav>
            {% endif %}
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var form = document.getElementById('patients-form');
        var wrap = document.getElementById('patient-table');

        /* Changing a menu applies it straight away (a new filter or page
           size always starts from page 1 -- the form has no page field). */
        document.querySelectorAll('[data-autosubmit]').forEach(function(sel) {
            sel.addEventListener('change', function() { form.requestSubmit(); });
        });

        /* Leave empty filters out of the address (?q=&area= is just noise). */
        form.addEventListener('submit', function() {
            form.querySelectorAll('input[name="q"], select[name="area"]').forEach(function(el) {
                if (el.value === '') el.disabled = true;
            });
        });

        /* Compact mode: one line per patient. Remembered in this browser only. */
        var comfy = document.getElementById('density-comfy');
        var compact = document.getElementById('density-compact');
        function setCompact(on) {
            wrap.classList.toggle('is-compact', on);
            compact.setAttribute('aria-pressed', on ? 'true' : 'false');
            comfy.setAttribute('aria-pressed', on ? 'false' : 'true');
            try { localStorage.setItem('zpms_patients_compact', on ? '1' : '0'); } catch (e) {}
        }
        comfy.addEventListener('click', function() { setCompact(false); });
        compact.addEventListener('click', function() { setCompact(true); });
        try { if (localStorage.getItem('zpms_patients_compact') === '1') setCompact(true); } catch (e) {}

        /* Clicking anywhere on a row opens the record, except on a link,
           button, copy icon or selected text, which keep their own action. */
        wrap.querySelectorAll('tbody tr[data-href]').forEach(function(row) {
            row.addEventListener('click', function(e) {
                if (e.target.closest('a, button, i[data-copy-text]')) return;
                if (window.getSelection && String(window.getSelection())) return;
                window.location.href = row.dataset.href;
            });
        });
    });
</script>
