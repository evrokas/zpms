{% attach_library('boxicons') %}

{# ── Page header: title + actions (mimics topbar-left/right pattern) ── #}
<div class="page-header">
    <div class="page-header-left">
        <h1>{{t("Patients")}}</h1>
    </div>
    <div class="page-header-right">
        <a href="{{rel_url('/patient/new')}}" class="btn btn-sm btn-primary"><i class="bx bx-plus"></i> {{t("New Patient")}}</a>
    </div>
</div>

{# ── Search / Filter card ── #}
<div class="card mb-lg">
    <div class="card-body">
        <form action="{{rel_url('patients/search')}}" method="post">
            <div class="filter-bar">
                {% set $searchAttributes = new Attributes([
                    'type' => 'text',
                    'class' => 'form-input search-input select2',
                    'name' => 'search-term',
                    'autocomplete' => 'off',
                    'placeholder' => t('Search patients by name or AMKA...')
                    ]); %}
                {% if isset($search_term) %}
                    {% $searchAttributes->addAttributeS('value', $search_term); %}
                {% endif %}
                <input {{attributes($searchAttributes)}}>
                <div class="select-container">
                    <ul class="select-box" id="select-box"></ul>
                </div>
                <button type="submit" class="btn btn-outline">{{t("Reset")}}</button>
            </div>
        </form>
    </div>
</div>

{# ── Patients table card ── #}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">{{t("All Patients")}}</h3>
        <span class="text-sm text-muted">{{count($pat_list)}} {{t("records")}}</span>
    </div>
    <div class="card-body" style="padding:0;">
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>
                            {{t("Name")}}
                            <span class="sorting-arrows">
                                <i class="bx bx-chevron-down"></i>
                                <i class="bx bx-chevron-up"></i>
                            </span>
                        </th>
                        <th>{{t("AMKA")}}</th>
                        <th>
                            {{t("Last App")}}
                            <span class="sorting-arrows">
                                <i class="bx bx-chevron-down"></i>
                                <i class="bx bx-chevron-up"></i>
                            </span>
                        </th>
                        <th>{{t("Actions")}}</th>
                    </tr>
                </thead>
                <tbody>
                    {% foreach($pat_list as $pat): %}
                    <tr>
                        <td data-column="name">
                            <div class="font-medium">
                                <a href="{{rel_url('/patient/'.$pat['id'].'/edit')}}">{{$pat['pname']}}</a>
                            </div>
                            {% if(strlen($pat['pname'])>0): %}
                                <i class='bx bx-copy text-sm' style="cursor:pointer;color:var(--gray-400);margin-left:4px;" onclick="copyStr('{{$pat['pname']}}')" data-copy-text="{{$pat['pname']}}"></i>
                            {% endif %}
                        </td>

                        <td data-column="amka" style="font-family:monospace;">
                            {{$pat['pamka']}}
                            {% if(strlen($pat['pamka'])>0): %}
                                <i class='bx bx-copy text-sm' style="cursor:pointer;color:var(--gray-400);margin-left:4px;" onclick="copyStr('{{$pat['pamka']}}')" data-copy-text="{{$pat['pamka']}}"></i>
                            {% endif %}
                        </td>

                        <td data-column="lastapp">
                            {% if($pat['lastapp']): %}
                                {% echo explode(' ', $pat['lastapp'])[0]; %}
                            {% else: %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>

                        <td data-column="actions">
                            <div class="action-buttons">
                                <a href="{{rel_url('/patient/'.$pat['id'].'/edit')}}" class="action-btn" title="{{t('Edit')}}"><i class="bx bx-edit"></i> {{t("Edit")}}</a>
                                <a href="{{rel_url('/patient/'.$pat['id'].'/delete')}}" class="action-btn" confirmation title="{{t('Delete')}}"><i class="bx bx-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                    {% endforeach %}
                </tbody>
            </table>
        </div>
    </div>
</div>
