{% attach_library('boxicons') %}
{% attach_library('schedule') %}
{#
  schedule.zetem -- the appointment schedule (/schedule), rendered by
  schedule_view() in web/schedule_pages.php. The calendar itself is drawn by
  web/js/schedule.js from the JSON in #schedule-data; this template only holds
  the page chrome. The weekly pattern and travel times are edited in Settings
  (settings.zetem, web/js/schedule-setup.js).
#}

<h2 class="sr-only">{{{t('Appointment schedule')}}}</h2>

{% if($missing_table): %}
<p class="sched-notice">{{{t('The schedule tables do not exist yet. Create them as described in the README, then reload this page.')}}}</p>
{% else: %}

<script type="application/json" id="schedule-data">{{ $model_json }}</script>

<div class="sched-bar">
    <a class="sched-btn" href="{{{$prev_url}}}" aria-label="{{{t('Previous week')}}}">&lsaquo;</a>
    <strong class="sched-range">{{{$range_label}}}</strong>
    <a class="sched-btn" href="{{{$next_url}}}" aria-label="{{{t('Next week')}}}">&rsaquo;</a>
    <a class="sched-btn" href="{{{$today_url}}}">{{{t('Today')}}}</a>
    <span class="sched-grow"></span>
    <a class="sched-btn" href="{{{$cancelled_toggle_url}}}">{{($show_cancelled) ? t('Hide cancelled') : t('Show cancelled')}}</a>
    <a class="sched-btn" href="{{{$cancelled_list_url}}}">{{{t('Cancelled bookings')}}}</a>
    {% if($setup_url): %}
    <a class="sched-btn" href="{{{$setup_url}}}"><i class="bx bx-cog"></i> {{{t('Schedule setup')}}}</a>
    {% endif %}
</div>

<nav class="sched-tabs" aria-label="{{{t('Location')}}}">
    {% foreach($loc_tabs as $tab): %}
    <a href="{{{$tab['url']}}}" class="{{($tab['active']) ? 'on' : ''}}" {{($tab['active']) ? 'aria-current="page"' : ''}}>{{{$tab['name']}}}</a>
    {% endforeach %}
</nav>

<div class="sched-tool">
    <span>{{{t('Drag on the calendar to:')}}}</span>
    <span class="sched-seg" id="sched-tools" role="group">
        <button type="button" class="on" data-tool="book">{{{t('Make an appointment')}}}</button>
        <button type="button" data-tool="available">{{{t('Open')}}}</button>
        <button type="button" data-tool="surgery">{{{t('Surgery')}}}</button>
        <button type="button" data-tool="hold">{{{t('Reserve')}}}</button>
        <button type="button" data-tool="clear">{{{t('Back to the pattern')}}}</button>
    </span>
</div>

<p class="sched-legend">
    <span><i class="sw-avail"></i>{{{t('Free')}}}</span>
    <span><i class="sw-resv"></i>{{{t('Booked appointment')}}}</span>
    <span><i class="sw-opsurg"></i>{{{t('Booked operation')}}}</span>
    <span><i class="sw-seen"></i>{{{t('Appointment not held on the schedule (patient record)')}}}</span>
    <span><i class="sw-hold"></i>{{{t('Reserved, with a reason')}}}</span>
    <span><i class="sw-surg"></i>{{{t('Surgery')}}}</span>
    <span><i class="sw-shadow"></i>{{{t('Surgery or booking elsewhere (plus travel)')}}}</span>
</p>

<div class="sched-cal"><div class="sched-grid" id="sched-grid"></div></div>
<div class="sched-panel" id="sched-panel"></div>

{% endif %}
