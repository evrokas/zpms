# Reference site config for zops (lib/zops's bin/zops-backup,
# bin/zops-monitor, bin/zops-restore, bin/zops-doctor) -- ZPMS's own
# backup/health-check registration. See lib/zops/docs/INSTALL.md for the
# clone command and lib/zops/docs/HANDLERS.md for what
# backup-handler.php/health-handler.php (both in this same deploy/
# directory) actually do. Replaces bin/backup.sh/deploy/zpms-backup.*
# (deleted; see git history if ever needed for reference).
#
# Install:
#   sudo mkdir -p /etc/zops/sites.d
#   sudo cp deploy/backup.conf.example /etc/zops/sites.d/zpms.conf
#   sudo $EDITOR /etc/zops/sites.d/zpms.conf
#   sudo chmod 600 /etc/zops/sites.d/zpms.conf
#
# Recommended: a dedicated "zops" system user, group-shared with whichever
# user Apache/PHP actually runs as -- a compromised web app shouldn't
# automatically also have the off-site backup SSH key, and the same group
# membership web/files/ needs for the handler's Dir::link() hardlinks to
# succeed (fs.protected_hardlinks -- see lib/zops/docs/SECURITY.md).

BACKUP_HANDLER=/var/www/zpms/deploy/backup-handler.php
HEALTH_HANDLER=/var/www/zpms/deploy/health-handler.php

# Same filesystem as web/files/ so Dir::link() hardlinks
# appointment_files/ for free -- the exact role web/files/.backup_stage/
# used to play for the old bin/backup.sh.
WORK_DIR=/var/www/zpms/web/files/.zops_work
LOG_FILE=/var/log/zops/zpms-backup.log
HEALTH_TIMEOUT=30

# Read by core/modules/backup/backup.php's status page (?table=... no --
# the /apps/backup route) -- set the SAME path as zops_backup_status_file
# in this app's own config/site.info.yaml.
STATUS_FILE=/var/lib/zops/zpms-backup-status.json

# --- Destinations (one or more) -----------------------------------------
DEST_1=ssh:zops@backup.example.com:/srv/zops-backups/zpms
DEST_1_KEY=/home/zops/.ssh/id_ed25519
#DEST_2=local:/mnt/usb-backup/zpms

# --- Retention (tiered daily/weekly/monthly) -----------------------------
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# --- Collector (optional) ------------------------------------------------
COLLECTOR_URL=https://backup-status.example.com/ingest.php
COLLECTOR_KEY=

# This app bundles config/db.php (+ config/docarc_api.php if configured)
# into its "config" backup element -- see lib/zops/docs/SECURITY.md
# before choosing a destination for these.
#ENCRYPT_ELEMENTS=true
#ENCRYPT_PASSPHRASE=

TIMEOUT=1800
