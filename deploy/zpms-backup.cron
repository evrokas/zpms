# Reference cron.d entry for ZPMS's nightly backup + periodic health
# check, via the shared zops engine (lib/zops -- see
# lib/zops/docs/INSTALL.md). Replaces the old bin/backup.sh-based
# deploy/zpms-backup.cron/.timer/.service (deleted; git history has them
# if ever needed for reference).
#
# Install:
#   sudo cp deploy/zpms-backup.cron /etc/cron.d/zpms-backup
#   sudo chmod 644 /etc/cron.d/zpms-backup
#
# See deploy/backup.conf.example's own comment for the recommended
# dedicated "zops" system user and why.

# Nightly backup.
0 2 * * *  zops  flock -n /run/lock/zops-zpms-backup.lock /var/www/zpms/lib/zops/bin/zops-backup --site=zpms >> /var/log/zops/zpms-backup-cron.log 2>&1

# Health check every 15 minutes -- --email-on-change means this only
# actually emails the administrator (ADMIN_EMAIL in /etc/zops/defaults.conf)
# when something changes, or a failure has persisted long enough to
# warrant a reminder, not on every single run.
*/15 * * * *  zops  /var/www/zpms/lib/zops/bin/zops-monitor --site=zpms --email-on-change >> /var/log/zops/zpms-monitor-cron.log 2>&1
