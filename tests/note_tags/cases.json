      "expect": [
        {
          "tag": "lvl",
          "value": "Ο4-Ο5",
          "normalized": "Ο4-Ο5",
          "valid": true
        },
        {
          "tag": "lvl",
          "value": "ο4-5",
          "normalized": "Ο4-Ο5",
          "valid": true
        },
        {
          "tag": "lvl",
          "value": "Ο4/Ο5",
          "normalized": "Ο4-Ο5",
          "valid": true
        },
        {
          "tag": "lvl",
          "value": "L4-L5",
          "normalized": "Ο4-Ο5",
          "valid": true
        },
        {
          "tag": "lvl",
          "value": "l4-5",
          "normalized": "Ο4-Ο5",
          "valid": true
        },
        {
          "tag": "lvl",
          "value": "Ο5-Ι1",
          "normalized": "Ο5-Ι1",
          "valid": true
        },
        {
          "tag": "lvl",
          "value": "Α5-Α6",
          "normalized": "Α5-Α6",
          "valid": true
        },
        {
          "tag": "lvl",
          "value": "Θ12",
          "normalized": "Θ12",
          "valid": true
        },
        {
          "tag": "lvl",
          "value": "Θ12-Ο1",
          "normalized": "Θ12-Ο1",
          "valid": true
        },
        {
          "tag": "lvl",
          "value": "O4-O5",
          "normalized": "Ο4-Ο5",
          "valid": true
        },
        {
          "tag": "lvl",
          "value": "c6-7",
          "normalized": "Α6-Α7",
          "valid": true
        }
      ]
    },
    {
      "name": "levels: several, joined by και or commas; the value stops after the last level",
