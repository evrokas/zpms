          "tag": "lvl",
          "value": "Ο4-Ο5",
          "normalized": "Ο4-Ο5",
          "valid": true,
          "origin": 0,
          "pos": 22
        },
        {
          "tag": "thx",
          "value": "επισκληρίδιος έγχυση στο Ο5-Ι1 και L4-L5"
